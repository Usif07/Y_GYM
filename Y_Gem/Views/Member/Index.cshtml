@model Y_GYM.Models.Member

@{
    ViewData["Title"] = "Member Dashboard";

    var activeSubscription = ViewBag.ActiveSubscription as Y_GYM.Models.Subscription;
    var nextBooking = ViewBag.NextBooking as Y_GYM.Models.Booking;

    int attendanceThisMonth = ViewBag.AttendanceThisMonth ?? 0;
    int remainingDays = ViewBag.RemainingDays ?? 0;

    var remainingVisitsValue = ViewBag.RemainingVisits as int?;
    var totalVisitsValue = ViewBag.TotalVisits as int?;
    var usedVisitsValue = ViewBag.UsedVisits as int?;

    var remainingVisits = remainingVisitsValue ?? 0;
    var totalVisits = totalVisitsValue ?? 0;
    var usedVisits = usedVisitsValue ?? 0;

    double visitPercentage = 0;

    if (totalVisits > 0)
    {
        visitPercentage =
            Math.Min(
                100,
                Math.Max(
                    0,
                    ((double)remainingVisits / totalVisits) * 100
                )
            );
    }
}

<section class="gym-page">

    <div class="container">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <div class="gym-page-header">

            <span class="page-label">
                MEMBER AREA
            </span>

            <h1>
                Member Dashboard
            </h1>

            <p>
                Welcome back, @Model.FullName.
                Manage your membership, bookings and fitness progress.
            </p>

        </div>


        <!-- ===================================================== -->
        <!-- SUCCESS / ERROR -->
        <!-- ===================================================== -->

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-4">
                <i class="fa fa-check-circle me-2"></i>
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-4">
                <i class="fa fa-exclamation-circle me-2"></i>
                @TempData["Error"]
            </div>
        }


        <!-- ===================================================== -->
        <!-- WELCOME -->
        <!-- ===================================================== -->

        <div class="member-welcome mb-4">

            <div>

                <span class="dashboard-label">
                    WELCOME BACK
                </span>

                <h2 class="text-white fw-bold mb-2">
                    Hello, @Model.FullName
                </h2>

                <p class="text-white-50 mb-0">
                    Keep training, stay consistent and track your progress.
                </p>

            </div>

            <div class="member-dashboard-icon">

                <i class="fa fa-user"></i>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- OVERVIEW CARDS -->
        <!-- ===================================================== -->

        <div class="row g-4 mb-4">

            <!-- Membership -->

            <div class="col-md-6 col-xl">

                <div class="member-dashboard-card h-100">

                    <div class="member-dashboard-icon">

                        <i class="fa fa-id-card-o"></i>

                    </div>

                    <span class="dashboard-label">
                        MEMBERSHIP
                    </span>

                    <div class="dashboard-value">

                        @if (activeSubscription != null)
                        {
                            @activeSubscription.MembershipPlan?.Name
                        }
                        else
                        {
                            <span>
                                None
                            </span>
                        }

                    </div>

                    <div class="dashboard-subtitle">

                        @if (activeSubscription != null)
                        {
                            <span class="member-status">
                                @activeSubscription.Status
                            </span>
                        }
                        else
                        {
                            <span>
                                No active membership
                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- Remaining Visits -->

            <div class="col-md-6 col-xl">

                <div class="member-dashboard-card h-100">

                    <div class="member-dashboard-icon">

                        <i class="fa fa-ticket"></i>

                    </div>

                    <span class="dashboard-label">
                        REMAINING VISITS
                    </span>

                    <div class="dashboard-value">

                        @if (remainingVisitsValue.HasValue)
                        {
                            @remainingVisits
                        }
                        else
                        {
                            <span>
                                —
                            </span>
                        }

                    </div>

                    <div class="dashboard-subtitle">

                        @if (remainingVisitsValue.HasValue)
                        {
                            if (totalVisits > 0)
                            {
                                <span>
                                    @usedVisits used of @totalVisits
                                </span>
                            }
                            else
                            {
                                <span>
                                    Visits remaining
                                </span>
                            }
                        }
                        else
                        {
                            <span>
                                Membership visits
                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- Membership End -->

            <div class="col-md-6 col-xl">

                <div class="member-dashboard-card h-100">

                    <div class="member-dashboard-icon">

                        <i class="fa fa-calendar-check-o"></i>

                    </div>

                    <span class="dashboard-label">
                        MEMBERSHIP END
                    </span>

                    <div class="dashboard-value">

                        @if (activeSubscription != null)
                        {
                            @activeSubscription.EndDate.ToString("dd MMM")
                        }
                        else
                        {
                            <span>
                                —
                            </span>
                        }

                    </div>

                    <div class="dashboard-subtitle">

                        @if (activeSubscription != null)
                        {
                            @activeSubscription.EndDate.ToString("yyyy")
                        }
                        else
                        {
                            <span>
                                No active membership
                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- Remaining Days -->

            <div class="col-md-6 col-xl">

                <div class="member-dashboard-card h-100">

                    <div class="member-dashboard-icon">

                        <i class="fa fa-clock-o"></i>

                    </div>

                    <span class="dashboard-label">
                        REMAINING DAYS
                    </span>

                    <div class="dashboard-value">

                        @if (activeSubscription != null)
                        {
                            @remainingDays
                        }
                        else
                        {
                            <span>
                                —
                            </span>
                        }

                    </div>

                    <div class="dashboard-subtitle">
                        @if (activeSubscription != null)
                        {
                            <span>
                                days remaining
                            </span>
                        }
                        else
                        {
                            <span>
                                No active membership
                            </span>
                        }
                    </div>

                </div>

            </div>


            <!-- Attendance -->

            <div class="col-md-6 col-xl">

                <div class="member-dashboard-card h-100">

                    <div class="member-dashboard-icon">

                        <i class="fa fa-line-chart"></i>

                    </div>

                    <span class="dashboard-label">
                        ATTENDANCE
                    </span>

                    <div class="dashboard-value">
                        @attendanceThisMonth
                    </div>

                    <div class="dashboard-subtitle">
                        Visits this month
                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- REMAINING VISITS PROGRESS -->
        <!-- ===================================================== -->

        @if (remainingVisitsValue.HasValue && totalVisits > 0)
        {
            <div class="member-page-card mb-4">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>

                        <h3 class="member-section-title mb-1">
                            Membership Usage
                        </h3>

                        <p class="text-white-50 mb-0">
                            Track your remaining membership visits.
                        </p>

                    </div>

                    <div class="member-dashboard-icon mb-0">

                        <i class="fa fa-pie-chart"></i>

                    </div>

                </div>


                <div class="d-flex justify-content-between mb-2">

                    <span class="text-white-50">
                        Visits remaining
                    </span>

                    <strong class="text-white">
                        @remainingVisits / @totalVisits
                    </strong>

                </div>


                <div class="progress"
                     style="height: 10px;">

                    <div class="progress-bar"
                         role="progressbar"
                         style="width: @visitPercentage.ToString("0.##")%;"
                         aria-valuenow="@remainingVisits"
                         aria-valuemin="0"
                         aria-valuemax="@totalVisits">
                    </div>

                </div>


                <div class="d-flex justify-content-between mt-2">

                    <small class="text-white-50">
                        @usedVisits used
                    </small>

                    <small class="text-white-50">
                        @remainingVisits remaining
                    </small>

                </div>

            </div>
        }


        <!-- ===================================================== -->
        <!-- PERSONAL INFORMATION + MEMBERSHIP -->
        <!-- ===================================================== -->

        <div class="row g-4 mb-4">

            <!-- Personal Information -->

            <div class="col-lg-6">

                <div class="member-page-card h-100">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h3 class="member-section-title mb-1">
                                Personal Information
                            </h3>

                            <p class="text-white-50 mb-0">
                                Your account information.
                            </p>

                        </div>

                        <div class="member-dashboard-icon mb-0">

                            <i class="fa fa-user"></i>

                        </div>

                    </div>


                    <div class="member-info-list">

                        <div class="member-info-row">

                            <span>
                                <i class="fa fa-user me-2"></i>
                                Full Name
                            </span>

                            <strong>
                                @Model.FullName
                            </strong>

                        </div>


                        <div class="member-info-row">

                            <span>
                                <i class="fa fa-phone me-2"></i>
                                Phone
                            </span>

                            <strong>
                                @Model.Phone
                            </strong>

                        </div>


                        <div class="member-info-row">

                            <span>
                                <i class="fa fa-calendar me-2"></i>
                                Join Date
                            </span>

                            <strong>
                                @Model.JoinDate.ToString("dd MMM yyyy")
                            </strong>

                        </div>


                        @if (Model.Weight.HasValue)
                        {
                            <div class="member-info-row">

                                <span>
                                    <i class="fa fa-balance-scale me-2"></i>
                                    Current Weight
                                </span>

                                <strong>
                                    @Model.Weight.Value.ToString("0.0") kg
                                </strong>

                            </div>
                        }


                        @if (Model.Height.HasValue)
                        {
                            <div class="member-info-row">

                                <span>
                                    <i class="fa fa-arrows-v me-2"></i>
                                    Height
                                </span>

                                <strong>
                                    @Model.Height.Value.ToString("0.0") cm
                                </strong>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Goal))
                        {
                            <div class="member-info-row">

                                <span>
                                    <i class="fa fa-bullseye me-2"></i>
                                    Goal
                                </span>

                                <strong>
                                    @Model.Goal
                                </strong>

                            </div>
                        }

                    </div>

                </div>

            </div>


            <!-- Membership -->

            <div class="col-lg-6">

                <div class="member-page-card h-100">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h3 class="member-section-title mb-1">
                                My Membership
                            </h3>

                            <p class="text-white-50 mb-0">
                                Your current membership details.
                            </p>

                        </div>

                        <div class="member-dashboard-icon mb-0">

                            <i class="fa fa-id-card"></i>

                        </div>

                    </div>


                    @if (activeSubscription != null)
                    {
                        <div class="member-info-list">

                            <div class="member-info-row">

                                <span>
                                    Plan
                                </span>

                                <strong>
                                    @activeSubscription.MembershipPlan?.Name
                                </strong>

                            </div>


                            <div class="member-info-row">

                                <span>
                                    Start Date
                                </span>

                                <strong>
                                    @activeSubscription.StartDate.ToString("dd MMM yyyy")
                                </strong>

                            </div>


                            <div class="member-info-row">

                                <span>
                                    End Date
                                </span>

                                <strong>
                                    @activeSubscription.EndDate.ToString("dd MMM yyyy")
                                </strong>

                            </div>


                            <div class="member-info-row">

                                <span>
                                    Status
                                </span>

                                <strong>

                                    <span class="member-status">
                                        @activeSubscription.Status
                                    </span>

                                </strong>

                            </div>


                            <div class="member-info-row">

                                <span>
                                    Remaining Days
                                </span>

                                <strong>
                                    @remainingDays days
                                </strong>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="member-empty">

                            <i class="fa fa-id-card-o"></i>

                            <h5 class="text-white">
                                No Active Membership
                            </h5>

                            <p class="mb-3">
                                You currently do not have an active membership.
                            </p>

                            <a asp-controller="MembershipPlans"
                               asp-action="Index"
                               class="btn primary-btn gym-btn">

                                <i class="fa fa-list me-2"></i>
                                View Membership Plans

                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- NEXT BOOKING + ATTENDANCE -->
        <!-- ===================================================== -->

        <div class="row g-4 mb-4">

            <!-- Next Booking -->

            <div class="col-lg-8">

                <div class="member-page-card h-100">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>

                            <h3 class="member-section-title mb-1">
                                Next Class
                            </h3>

                            <p class="text-white-50 mb-0">
                                Your upcoming confirmed booking.
                            </p>

                        </div>

                        <div class="member-dashboard-icon mb-0">

                            <i class="fa fa-calendar-check-o"></i>

                        </div>

                    </div>


                    @if (nextBooking != null)
                    {
                        <div class="row g-4 align-items-center">

                            <div class="col-md-7">

                                <span class="dashboard-label">
                                    CLASS
                                </span>

                                <h3 class="text-white fw-bold mb-3">

                                    @nextBooking.ClassSchedule?.Class?.Name

                                </h3>


                                <div class="member-info-list">

                                    <div class="member-info-row">

                                        <span>
                                            <i class="fa fa-calendar me-2"></i>
                                            Date
                                        </span>

                                        <strong>
                                            @nextBooking.ClassSchedule?.StartTime.ToString("dd MMM yyyy")
                                        </strong>

                                    </div>


                                    <div class="member-info-row">

                                        <span>
                                            <i class="fa fa-clock-o me-2"></i>
                                            Time
                                        </span>

                                        <strong>

                                            @nextBooking.ClassSchedule?.StartTime.ToString("HH:mm")
                                            -
                                            @nextBooking.ClassSchedule?.EndTime.ToString("HH:mm")

                                        </strong>

                                    </div>


                                    <div class="member-info-row">

                                        <span>
                                            <i class="fa fa-user me-2"></i>
                                            Trainer
                                        </span>

                                        <strong>

                                            @nextBooking.ClassSchedule?.Coach?.User?.FullName

                                        </strong>

                                    </div>

                                </div>

                            </div>


                            <div class="col-md-5">

                                <div class="text-center p-4 border rounded">

                                    <div class="member-dashboard-icon mx-auto mb-3">

                                        <i class="fa fa-ticket"></i>

                                    </div>

                                    <span class="dashboard-label">
                                        BOOKING STATUS
                                    </span>

                                    <div class="mt-2">

                                        <span class="member-status">
                                            Confirmed
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="member-empty">

                            <i class="fa fa-calendar-o"></i>

                            <h5 class="text-white">
                                No Upcoming Classes
                            </h5>

                            <p class="mb-3">
                                You don't have any upcoming confirmed classes.
                            </p>

                            <a asp-action="Schedule"
                               class="btn primary-btn gym-btn">

                                <i class="fa fa-calendar me-2"></i>
                                View Class Schedule

                            </a>

                        </div>
                    }

                </div>

            </div>


            <!-- Attendance -->

            <div class="col-lg-4">

                <div class="member-page-card h-100">

                    <div class="member-dashboard-icon">

                        <i class="fa fa-check-circle"></i>

                    </div>

                    <span class="dashboard-label">
                        THIS MONTH
                    </span>

                    <div class="dashboard-value">
                        @attendanceThisMonth
                    </div>

                    <h4 class="text-white fw-bold mt-2">
                        Gym Visits
                    </h4>

                    <p class="text-white-50">
                        Your attendance count for the current month.
                    </p>


                    <a asp-action="Progress"
                       class="btn btn-outline-light w-100 mt-3">

                        <i class="fa fa-line-chart me-2"></i>
                        View My Progress

                    </a>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- QUICK ACTIONS -->
        <!-- ===================================================== -->

        <div class="mb-3">

            <h3 class="member-section-title">
                Quick Actions
            </h3>

            <p class="text-white-50">
                Quickly access your most important member features.
            </p>

        </div>


        <div class="row g-4">

            <!-- Schedule -->

            <div class="col-md-6 col-lg-3">

                <a asp-action="Schedule"
                   class="member-action-card text-decoration-none">

                    <div class="member-dashboard-icon">

                        <i class="fa fa-calendar"></i>

                    </div>

                    <h5>
                        Class Schedule
                    </h5>

                    <p>
                        Browse upcoming classes and book your place.
                    </p>

                    <span>
                        View Schedule
                        <i class="fa fa-arrow-right ms-1"></i>
                    </span>

                </a>

            </div>


            <!-- Bookings -->

            <div class="col-md-6 col-lg-3">

                <a asp-action="MyBookings"
                   class="member-action-card text-decoration-none">

                    <div class="member-dashboard-icon">

                        <i class="fa fa-ticket"></i>

                    </div>

                    <h5>
                        My Bookings
                    </h5>

                    <p>
                        View and manage your class bookings.
                    </p>

                    <span>
                        My Bookings
                        <i class="fa fa-arrow-right ms-1"></i>
                    </span>

                </a>

            </div>


            <!-- Progress -->

            <div class="col-md-6 col-lg-3">

                <a asp-action="Progress"
                   class="member-action-card text-decoration-none">

                    <div class="member-dashboard-icon">

                        <i class="fa fa-line-chart"></i>

                    </div>

                    <h5>
                        My Progress
                    </h5>

                    <p>
                        Track your weight and fitness progress.
                    </p>

                    <span>
                        View Progress
                        <i class="fa fa-arrow-right ms-1"></i>
                    </span>

                </a>

            </div>


            <!-- Membership Plans -->

            <div class="col-md-6 col-lg-3">

                <a asp-controller="MembershipPlans"
                   asp-action="Index"
                   class="member-action-card text-decoration-none">

                    <div class="member-dashboard-icon">

                        <i class="fa fa-list"></i>

                    </div>

                    <h5>
                        Membership Plans
                    </h5>

                    <p>
                        Explore available membership plans.
                    </p>

                    <span>
                        View Plans
                        <i class="fa fa-arrow-right ms-1"></i>
                    </span>

                </a>

            </div>

        </div>

    </div>

</section>