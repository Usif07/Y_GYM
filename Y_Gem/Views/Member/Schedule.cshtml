@model IEnumerable<Y_GYM.Models.ClassSchedule>
@{
    ViewData["Title"] = "Class Schedule";
}

<div class="container mt-4">
    <h2 class="mb-4 text-dark">Weekly Class Schedule</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-light border text-center py-5">
            <p class="mb-0 text-muted">There are currently no scheduled classes</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Class</th>
                        <th>Coach</th>
                        <th>The Date</th>
                        <th>Available places</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.Class.Name</td>
                            <td>@s.Coach.coachSpecialty</td>
                            <td>@s.StartTime.ToString("ddd dd/MM - HH:mm")</td>
                            <td>
                                @if (s.AvailablePlaces > 0)
                                {
                                    <span class="badge bg-success">@s.AvailablePlaces Available spot</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Full capacity</span>
                                }
                            </td>
                            <td>
                                <form method="post" asp-action="BookClass" class="d-inline">
                                    <input type="hidden" name="scheduleId" value="@s.Id" />
                                    <button type="submit" class="btn btn-sm btn-dark"
                                            @(s.AvailablePlaces <= 0 ? "disabled" : "")>
                                        Book
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>