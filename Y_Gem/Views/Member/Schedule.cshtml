@model IEnumerable<Y_GYM.Models.ClassSchedule>

@{
    ViewData["Title"] = "Class Schedule";
}

<section class="gym-page">

    <div class="container">

        <div class="gym-page-header">

            <span class="page-label">
                FITNESS GYM
            </span>

            <h1>
                Class Schedule
            </h1>

            <p>
                Explore available classes and reserve your place.
            </p>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-4">

                <i class="fa fa-check-circle me-2"></i>

                @TempData["Success"]

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-4">

                <i class="fa fa-exclamation-circle me-2"></i>

                @TempData["Error"]

            </div>
        }


        <div class="member-page-card">

            @if (Model != null && Model.Any())
            {
                <div class="member-table-wrapper">

                    <table class="table member-table align-middle">

                        <thead>

                            <tr>

                                <th>Class</th>
                                <th>Coach</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Available Places</th>
                                <th class="text-end">Action</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @item.Class?.Name
                                        </strong>

                                    </td>

                                    <td>
                                        @item.Coach?.User?.FullName
                                    </td>

                                    <td>
                                        @item.StartTime
                                        .ToString("dd MMM yyyy - HH:mm")
                                    </td>

                                    <td>
                                        @item.EndTime
                                        .ToString("HH:mm")
                                    </td>

                                    <td>

                                        @if (item.AvailablePlaces > 5)
                                        {
                                            <span class="member-status">

                                                <i class="fa fa-check-circle"></i>

                                                @item.AvailablePlaces available

                                            </span>
                                        }
                                        else if (item.AvailablePlaces > 0)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="fa fa-exclamation-triangle me-1"></i>

                                                Only @item.AvailablePlaces left

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Full
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        @if (item.AvailablePlaces > 0)
                                        {
                                            <form asp-action="BookClass"
                                                  asp-route-scheduleId="@item.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm primary-btn gym-btn">

                                                    <i class="fa fa-ticket me-1"></i>

                                                    Book Class

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-secondary"
                                                    disabled>

                                                <i class="fa fa-ban me-1"></i>

                                                Full

                                            </button>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="member-empty">

                    <i class="fa fa-calendar-o"></i>

                    <h4 class="text-white mb-2">
                        No Classes Available
                    </h4>

                    <p class="mb-0">
                        There are currently no classes scheduled.
                    </p>

                </div>
            }

        </div>


        <div class="d-flex flex-wrap gap-2 mt-4">

            <a asp-action="Index"
               class="btn btn-outline-light">

                <i class="fa fa-dashboard me-2"></i>
                Dashboard

            </a>

            <a asp-action="MyBookings"
               class="btn primary-btn gym-btn">

                <i class="fa fa-ticket me-2"></i>
                My Bookings

            </a>

            <a asp-action="Progress"
               class="btn btn-outline-light">

                <i class="fa fa-line-chart me-2"></i>
                My Progress

            </a>

        </div>

    </div>

</section>
