@model IEnumerable<Y_GYM.Models.Booking>
@{
    ViewData["Title"] = "My bookings";
    var now = DateTime.Now;
    var upcoming = Model.Where(b => b.ClassSchedule.StartTime > now && b.Status == "Confirmed");
    var past = Model.Where(b => b.ClassSchedule.StartTime <= now || b.Status != "Confirmed");
}

<div class="container mt-4">
    <h2 class="mb-4 text-dark">My bookings</h2>

    <h5 class="text-secondary fw-bold mb-3">Next</h5>
    @if (!upcoming.Any())
    {
        <div class="alert alert-light border text-center py-4 mb-4">
            <p class="mb-0 text-muted">There are no upcoming bookings — <a asp-action="Schedule">Book a session now</a></p>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var b in upcoming)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h6 class="fw-bold">@b.ClassSchedule.Class.Name</h6>
                            <p class="text-muted mb-1">@b.ClassSchedule.StartTime.ToString("ddd dd/MM - HH:mm")</p>
                            <form method="post" asp-action="CancelBooking">
                                <input type="hidden" name="bookingId" value="@b.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Are you sure you want to cancel your booking?');">
                                    Cancel Booking
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h5 class="text-secondary fw-bold mb-3">Previous</h5>
    @if (!past.Any())
    {
        <p class="text-muted">There is no record of previous bookings</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead class="table-light">
                    <tr>
                        <th>Class</th>
                        <th>The Date</th>
                        <th>State</th>
                        <th>Attendance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in past)
                    {
                        <tr>
                            <td>@b.ClassSchedule.Class.Name</td>
                            <td>@b.ClassSchedule.StartTime.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (b.Status == "Cancelled")
                                {
                                    <span class="badge bg-secondary">Canceled</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Expired</span>
                                }
                            </td>
                            <td>
                                @if (b.IsAttended)
                                {
                                    <span class="text-success">✓ Attended</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>