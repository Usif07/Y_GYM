@model Y_GYM.Models.ViewModels.RegisterPaymentVM

@using Y_GYM.Models

@{
    ViewData["Title"] = "Register Payment";

    var plans =
        ViewBag.Plans as List<MembershipPlan>
        ?? new List<MembershipPlan>();
}

<section class="gym-page">

    <div class="container">

        <div class="gym-page-header">

            <span class="page-label">
                STAFF AREA
            </span>

            <h1>
                Register Payment
            </h1>

            <p>
                Create a membership subscription and record the member payment.
            </p>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-4">

                <i class="fa fa-check-circle me-2"></i>

                @TempData["Success"]

            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-4">

                <i class="fa fa-exclamation-circle me-2"></i>

                @TempData["Error"]

            </div>
        }


        <div class="row justify-content-center">

            <div class="col-xl-9">

                <div class="member-page-card">

                    <form asp-action="RegisterPayment"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <!-- MEMBER -->

                        <div class="mb-4">

                            <h3 class="member-section-title mb-1">
                                Member
                            </h3>

                            <p class="text-white-50">
                                Identify the member using their phone number.
                            </p>

                        </div>


                        <div class="row g-4">

                            <div class="col-md-12">

                                <label asp-for="Phone"
                                       class="form-label">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="fa fa-phone"></i>
                                    </span>

                                    <input asp-for="Phone"
                                           type="tel"
                                           class="form-control"
                                           placeholder="Enter member phone number" />

                                </div>

                                <span asp-validation-for="Phone"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <hr class="my-5" />


                        <!-- PLAN -->

                        <div class="mb-4">

                            <h3 class="member-section-title mb-1">
                                Membership Plan
                            </h3>

                            <p class="text-white-50">
                                Select the membership plan purchased by the member.
                            </p>

                        </div>


                        <div class="row g-4">

                            <div class="col-md-8">

                                <label asp-for="PlanId"
                                       class="form-label">
                                </label>

                                <select asp-for="PlanId"
                                        class="form-select"
                                        id="planSelect">

                                    <option value="">
                                        -- Select Membership Plan --
                                    </option>

                                    @foreach (var plan in plans)
                                    {
                                        <option value="@plan.Id"
                                                data-price="@plan.Price">

                                            @plan.Name
                                            -
                                            @plan.Price.ToString("0.00") EGP
                                            -
                                            @plan.DurationDays days

                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="PlanId"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label class="form-label">
                                    Plan Price
                                </label>

                                <div class="form-control"
                                     id="planPriceDisplay">

                                    Select a plan

                                </div>

                            </div>

                        </div>


                        <hr class="my-5" />


                        <!-- PAYMENT -->

                        <div class="mb-4">

                            <h3 class="member-section-title mb-1">
                                Payment
                            </h3>

                            <p class="text-white-50">
                                Enter the amount received from the member.
                            </p>

                        </div>


                        <div class="row g-4">

                            <div class="col-md-6">

                                <label asp-for="AmountPaid"
                                       class="form-label">
                                </label>

                                <div class="input-group">

                                    <input asp-for="AmountPaid"
                                           type="number"
                                           step="0.01"
                                           min="1"
                                           class="form-control"
                                           id="amountPaid"
                                           placeholder="Enter amount" />

                                    <span class="input-group-text">
                                        EGP
                                    </span>

                                </div>

                                <span asp-validation-for="AmountPaid"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Change
                                </label>

                                <div class="form-control"
                                     id="changeDisplay">

                                    0.00 EGP

                                </div>

                            </div>

                        </div>


                        <!-- ACTIONS -->

                        <div class="d-flex flex-wrap gap-2 mt-5">

                            <button type="submit"
                                    class="btn primary-btn gym-btn">

                                <i class="fa fa-credit-card me-2"></i>

                                Confirm Payment

                            </button>


                            <a asp-action="Index"
                               class="btn btn-outline-light">

                                <i class="fa fa-arrow-left me-2"></i>

                                Back to Dashboard

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const planSelect =
            document.getElementById("planSelect");

        const planPriceDisplay =
            document.getElementById("planPriceDisplay");

        const amountPaid =
            document.getElementById("amountPaid");

        const changeDisplay =
            document.getElementById("changeDisplay");


        function updatePaymentDetails() {

            const selectedOption =
                planSelect.options[planSelect.selectedIndex];

            const price =
                parseFloat(
                    selectedOption?.dataset.price || "0"
                );

            const amount =
                parseFloat(
                    amountPaid.value || "0"
                );


            if (price > 0) {

                planPriceDisplay.textContent =
                    price.toFixed(2) + " EGP";

            }
            else {

                planPriceDisplay.textContent =
                    "Select a plan";

            }


            const change =
                amount - price;


            if (change >= 0) {

                changeDisplay.textContent =
                    change.toFixed(2) + " EGP";

            }
            else {

                changeDisplay.textContent =
                    "0.00 EGP";

            }

        }


        planSelect.addEventListener(
            "change",
            updatePaymentDetails
        );


        amountPaid.addEventListener(
            "input",
            updatePaymentDetails
        );


        updatePaymentDetails();

    </script>

}