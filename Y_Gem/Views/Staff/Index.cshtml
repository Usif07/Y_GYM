
@model Y_GYM.Models.Staff

@{
    ViewData["Title"] = "Staff Dashboard";
}

<h1>Staff Dashboard</h1>

<hr />

<h4>Staff Information</h4>

<dl>

    <dt>
        @Html.DisplayNameFor(model => model.Id)
    </dt>
    <dd>
        @Html.DisplayFor(model => model.Id)
    </dd>


    <dt>
        @Html.DisplayNameFor(model => model.JobTitle)
    </dt>
    <dd>
        @Html.DisplayFor(model => model.JobTitle)
    </dd>


    <dt>
        @Html.DisplayNameFor(model => model.ShiftTime)
    </dt>
    <dd>
        @Html.DisplayFor(model => model.ShiftTime)
    </dd>


    <dt>
        User
    </dt>
    <dd>
        @Model.User?.FullName
    </dd>


    <dt>
        Email
    </dt>
    <dd>
        @Model.User?.Email
    </dd>


    <dt>
        Phone
    </dt>
    <dd>
        @Model.User?.PhoneNumber
    </dd>

</dl>

<hr />

<h4>Staff Operations</h4>

<p>
    <a asp-action="RegisterMember">
        Register New Member
    </a>
</p>


<h4>Check In Member</h4>

<form asp-action="CheckIn" method="post">

    <div>
        <label for="qrCode">QR Code</label>

        <input type="text"
               id="qrCode"
               name="qrCode" />

    </div>

    <div>
        <input type="submit"
               value="Check In" />
    </div>

</form>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
