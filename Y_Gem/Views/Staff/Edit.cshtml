@model Y_GYM.Models.Staff

@{
    ViewData["Title"] = "Edit Staff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-form-page {
        min-height: calc(100vh - 70px);
        padding: 90px 28px 40px;
        background: #101010;
    }

    .admin-form-container {
        max-width: 850px;
        margin: 0 auto;
    }

    .admin-form-header {
        margin-bottom: 30px;
    }

    .admin-form-header h1 {
        margin: 0 0 8px;
        color: #ffffff;
        font-size: 30px;
        font-weight: 700;
    }

    .admin-form-header p {
        margin: 0;
        color: #929292;
        font-size: 14px;
    }

    .admin-form-card {
        background: #151515;
        border: 1px solid #292929;
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, .25);
    }

    .form-section-title {
        color: #ff8c00;
        font-size: 17px;
        font-weight: 600;
        margin: 0 0 22px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #dddddd;
        font-size: 14px;
        font-weight: 500;
    }

    .form-control {
        width: 100%;
        min-height: 46px;
        padding: 10px 14px;
        border: 1px solid #303030;
        border-radius: 8px;
        background: #101010;
        color: #ffffff;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .form-control:focus {
        border-color: #ff8c00;
        box-shadow: 0 0 0 3px rgba(255, 140, 0, .10);
        background: #111111;
        color: #ffffff;
    }

    .form-control:disabled {
        background: #1b1b1b;
        color: #777777;
        cursor: not-allowed;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid #292929;
    }

    .btn-admin {
        min-width: 120px;
        min-height: 44px;
        padding: 9px 18px;
        border-radius: 8px;
        text-decoration: none;
        border: 1px solid transparent;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s ease;
    }

    .btn-save {
        background: #ff8c00;
        color: #111111;
        border-color: #ff8c00;
    }

    .btn-save:hover {
        background: #ff9d22;
        border-color: #ff9d22;
        color: #111111;
    }

    .btn-cancel {
        background: #1d1d1d;
        color: #dddddd;
        border-color: #333333;
    }

    .btn-cancel:hover {
        background: #252525;
        color: #ffffff;
        border-color: #444444;
    }

    @@media (max-width: 768px) {
        .admin-form-page {
            padding: 85px 18px 30px;
        }

        .admin-form-card {
            padding: 22px;
        }

        .admin-form-header h1 {
            font-size: 25px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-admin {
            width: 100%;
        }
    }
</style>

<div class="admin-form-page">
    <div class="admin-form-container">

        <div class="admin-form-header">
            <h1>Edit Staff</h1>
            <p>Update staff account and work information.</p>
        </div>

        <div class="admin-form-card">

            <h2 class="form-section-title">Account Information</h2>

            <form asp-controller="Staff" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.Id" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Full Name</label>
                            <input type="text"
                                   name="fullName"
                                   class="form-control"
                                   value="@Model.User?.FullName"
                                   required />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Username</label>
                            <input type="text"
                                   class="form-control"
                                   value="@Model.User?.UserName"
                                   disabled />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Email</label>
                            <input type="email"
                                   name="email"
                                   class="form-control"
                                   value="@Model.User?.Email"
                                   required />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Phone</label>
                            <input type="text"
                                   name="phone"
                                   class="form-control"
                                   value="@Model.User?.PhoneNumber" />
                        </div>
                    </div>
                </div>

                <h2 class="form-section-title" style="margin-top: 30px;">
                    Work Information
                </h2>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Job Title</label>
                            <input type="text"
                                   name="jobTitle"
                                   class="form-control"
                                   value="@Model.JobTitle"
                                   required />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Shift Time</label>
                            <input type="text"
                                   name="shiftTime"
                                   class="form-control"
                                   value="@Model.ShiftTime"
                                   required />
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-controller="Staff"
                       asp-action="Manage"
                       class="btn-admin btn-cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn-admin btn-save">
                        Save Changes
                    </button>
                </div>

            </form>
        </div>

    </div>
</div>