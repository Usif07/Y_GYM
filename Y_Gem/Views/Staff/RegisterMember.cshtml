@model Y_GYM.Models.ViewModels.RegisterMemberVM

@{
    ViewData["Title"] = "Register a New Member";
}

<div class="container mt-4">
    <h2 class="mb-4 text-dark">Register a New Member</h2>

    <form method="post" asp-controller="Staff" asp-action="RegisterMember" class="col-md-6">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label text-secondary fw-bold">Full Name</label>
            <input asp-for="FullName" class="form-control" placeholder="Abdo Helmy Essa " />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label text-secondary fw-bold">Email</label>
            <input asp-for="Email" class="form-control" placeholder="example@mail.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label text-secondary fw-bold">Phone Number</label>
            <input asp-for="Phone" class="form-control" placeholder="01xxxxxxxxx" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label text-secondary fw-bold">Initial Password</label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <hr class="my-4" />

        <div class="mb-3">
            <label asp-for="Weight" class="form-label text-secondary fw-bold">Weight (kg)</label>
            <input asp-for="Weight" class="form-control" type="number" step="0.1" />
            <span asp-validation-for="Weight" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Height" class="form-label text-secondary fw-bold">Height (cm)</label>
            <input asp-for="Height" class="form-control" type="number" step="0.1" />
            <span asp-validation-for="Height" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Goal" class="form-label text-secondary fw-bold">Target</label>
            <select asp-for="Goal" class="form-select">
                <option value="">-- Select a target --</option>
                <option value="Lose Weight">Weight Loss</option>
                <option value="Build Muscle">Muscle Building</option>
                <option value="Stay Fit">General Fitness</option>
            </select>
            <span asp-validation-for="Goal" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FitnessLevel" class="form-label text-secondary fw-bold">Current Level</label>
            <select asp-for="FitnessLevel" class="form-select">
                <option value="">-- Select a level --</option>
                <option value="Beginner">Beginner</option>
                <option value="Intermediate">Fair</option>
                <option value="Advanced">Advanced</option>
            </select>
            <span asp-validation-for="FitnessLevel" class="text-danger"></span>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-dark px-4" id="submitBtn">
                <span class="spinner-border spinner-border-sm d-none" id="submitSpinner"></span>
                Save
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2 px-4">Back</a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('form').addEventListener('submit', function () {
            document.getElementById('submitSpinner').classList.remove('d-none');
            document.getElementById('submitBtn').setAttribute('disabled', 'disabled');
        });
    </script>
}