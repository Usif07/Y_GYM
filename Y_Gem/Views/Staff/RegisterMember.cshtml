@model Y_GYM.Models.ViewModels.RegisterMemberVM

@{
    ViewData["Title"] = "Register New Member";
}

<h1>Register New Member</h1>

<h4>Member Information</h4>

<hr />

<form asp-controller="Staff"
      asp-action="RegisterMember"
      method="post">

    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label asp-for="FullName"></label>
        <input asp-for="FullName" />
        <span asp-validation-for="FullName"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Phone"></label>
        <input asp-for="Phone" type="tel" />
        <span asp-validation-for="Phone"></span>
    </div>

    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password"></span>
    </div>

    <hr />

    <div>
        <label asp-for="Weight"></label>
        <input asp-for="Weight"
               type="number"
               step="0.1" />
        <span asp-validation-for="Weight"></span>
    </div>

    <div>
        <label asp-for="Height"></label>
        <input asp-for="Height"
               type="number"
               step="0.1" />
        <span asp-validation-for="Height"></span>
    </div>

    <div>
        <label asp-for="Goal"></label>

        <select asp-for="Goal">
            <option value="">-- Select Goal --</option>
            <option value="Lose Weight">Weight Loss</option>
            <option value="Build Muscle">Muscle Building</option>
            <option value="Stay Fit">General Fitness</option>
        </select>

        <span asp-validation-for="Goal"></span>
    </div>

    <div>
        <label asp-for="FitnessLevel"></label>

        <select asp-for="FitnessLevel">
            <option value="">-- Select Fitness Level --</option>
            <option value="Beginner">Beginner</option>
            <option value="Intermediate">Intermediate</option>
            <option value="Advanced">Advanced</option>
        </select>

        <span asp-validation-for="FitnessLevel"></span>
    </div>

    <br />

    <div>
        <input type="submit" value="Register" />

        <a asp-action="Index">
            Back
        </a>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
