@model IEnumerable<Y_GYM.Models.Staff>

@{
    ViewData["Title"] = "Staff Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-page {
        padding: 90px 28px 35px;
        color: #f5f5f5;
        min-height: calc(100vh - 70px);
    }

    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 35px;
        margin-bottom: 32px;
        padding: 0 5px;
    }

    .admin-page-title {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
    }

    .admin-page-title-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 140, 0, 0.12);
        border: 1px solid rgba(255, 140, 0, 0.25);
        color: #ff8c00;
        font-size: 20px;
    }

    .admin-page-title h2 {
        margin: 0;
        font-size: 25px;
        line-height: 1.25;
        font-weight: 700;
        color: #ffffff;
    }

    .admin-page-title p {
        margin: 6px 0 0;
        color: #929292;
        font-size: 14px;
        line-height: 1.4;
    }

    .admin-add-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-shrink: 0;
        min-width: 125px;
        padding: 11px 18px;
        border-radius: 10px;
        border: 1px solid rgba(255, 140, 0, 0.35);
        background: #ff8c00;
        color: #111111;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition: 0.2s ease;
    }

    .admin-add-btn:hover {
        background: #ffa31a;
        color: #111111;
        transform: translateY(-1px);
    }

    .admin-alert {
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.08);
        background: #191919;
        color: #eeeeee;
        padding: 14px 18px;
        margin: 0 5px 22px;
    }

    .admin-alert-success {
        border-color: rgba(25, 135, 84, 0.35);
    }

    .admin-alert-danger {
        border-color: rgba(220, 53, 69, 0.35);
    }

    .admin-card {
        background: #151515;
        border: 1px solid #292929;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0,0,0,0.25);
    }

    .admin-card-header {
        min-height: 68px;
        padding: 18px 22px;
        border-bottom: 1px solid #292929;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        background: #171717;
    }

    .admin-card-header h5 {
        margin: 0;
        color: #ffffff;
        font-size: 17px;
        font-weight: 700;
    }

    .admin-count {
        background: rgba(255, 140, 0, 0.12);
        border: 1px solid rgba(255, 140, 0, 0.22);
        color: #ff9d22;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .admin-table-wrapper {
        overflow-x: auto;
    }

    .admin-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        min-width: 950px;
    }

    .admin-table thead th {
        background: #111111;
        color: #858585;
        border-bottom: 1px solid #292929;
        padding: 15px 18px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .admin-table tbody td {
        padding: 16px 18px;
        color: #d8d8d8;
        border-bottom: 1px solid #242424;
        background: #151515;
        vertical-align: middle;
    }

    .admin-table tbody tr {
        transition: background 0.2s ease;
    }

    .admin-table tbody tr:hover td {
        background: #1b1b1b;
    }

    .admin-table tbody tr:last-child td {
        border-bottom: none;
    }

    .staff-avatar {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 140, 0, 0.12);
        border: 1px solid rgba(255, 140, 0, 0.2);
        color: #ff9d22;
    }

    .staff-name {
        color: #ffffff;
        font-weight: 600;
        font-size: 14px;
    }

    .staff-id {
        color: #777777;
        font-size: 11px;
        margin-top: 3px;
    }

    .staff-username {
        color: #bdbdbd;
        font-size: 13px;
    }

    .staff-email,
    .staff-phone {
        color: #999999;
        font-size: 13px;
    }

    .job-badge {
        display: inline-flex;
        padding: 6px 10px;
        border-radius: 7px;
        background: rgba(255, 140, 0, 0.09);
        border: 1px solid rgba(255, 140, 0, 0.18);
        color: #ff9d22;
        font-size: 11px;
        font-weight: 700;
    }

    .shift-text {
        color: #bdbdbd;
        font-size: 13px;
    }

    .admin-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
    }

    .admin-action {
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        text-decoration: none;
        transition: 0.2s ease;
    }

    .admin-action-edit {
        color: #ff9d22;
        background: rgba(255, 140, 0, 0.08);
        border: 1px solid rgba(255, 140, 0, 0.16);
    }

    .admin-action-edit:hover {
        background: rgba(255, 140, 0, 0.18);
        color: #ffb14a;
    }

    .admin-action-delete {
        color: #e57373;
        background: rgba(220, 53, 69, 0.07);
        border: 1px solid rgba(220, 53, 69, 0.14);
    }

    .admin-action-delete:hover {
        background: rgba(220, 53, 69, 0.16);
        color: #ff8b8b;
    }

    .empty-state {
        text-align: center;
        padding: 70px 20px;
        color: #777777;
    }

    .empty-state-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 18px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1d1d1d;
        border: 1px solid #292929;
        color: #666666;
        font-size: 27px;
    }

    .empty-state h5 {
        color: #dddddd;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #777777;
        margin-bottom: 20px;
    }

    /* ============================================================
       TABLET
       ============================================================ */

    @@media (max-width: 992px) {

        .admin-page {
            padding: 85px 20px 30px;
        }

        .admin-page-header {
            gap: 25px;
        }

        .admin-page-title h2 {
            font-size: 22px;
        }
    }

    /* ============================================================
       MOBILE
       ============================================================ */

    @@media (max-width: 700px) {

        .admin-page {
            padding: 78px 14px 25px;
        }

        .admin-page-header {
            flex-direction: column;
            align-items: stretch;
            gap: 18px;
            margin-bottom: 25px;
            padding: 0;
        }

        .admin-page-title {
            align-items: flex-start;
        }

        .admin-page-title-icon {
            width: 44px;
            height: 44px;
            min-width: 44px;
            border-radius: 12px;
        }

        .admin-page-title h2 {
            font-size: 20px;
        }

        .admin-page-title p {
            font-size: 12px;
        }

        .admin-add-btn {
            width: 100%;
            min-height: 44px;
        }

        .admin-alert {
            margin-left: 0;
            margin-right: 0;
        }

        .admin-card {
            border-radius: 13px;
        }

        .admin-card-header {
            padding: 16px;
            min-height: 62px;
        }

        .admin-card-header h5 {
            font-size: 15px;
        }
    }
</style>

<div class="admin-page">

    <!-- PAGE HEADER -->
    <div class="admin-page-header">

        <div class="admin-page-title">

            <div class="admin-page-title-icon">
                <i class="fa fa-users"></i>
            </div>

            <div>
                <h2>Staff Management</h2>
                <p>Manage staff accounts, roles and information</p>
            </div>

        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Staff"
               asp-action="Create"
               class="admin-add-btn">
                <i class="fa fa-plus"></i>
                <span>Add Staff</span>
            </a>
        }

    </div>

    <!-- SUCCESS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-alert admin-alert-success">
            <i class="fa fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- ERROR -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="admin-alert admin-alert-danger">
            <i class="fa fa-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- STAFF CARD -->
    <div class="admin-card">

        <div class="admin-card-header">

            <h5>
                <i class="fa fa-id-card me-2"></i>
                Staff Members
            </h5>

            <span class="admin-count">
                @Model.Count() Staff
            </span>

        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    <i class="fa fa-users"></i>
                </div>

                <h5>No Staff Members</h5>

                <p>
                    There are currently no staff accounts.
                </p>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Staff"
                       asp-action="Create"
                       class="admin-add-btn">
                        <i class="fa fa-plus"></i>
                        Add First Staff
                    </a>
                }

            </div>
        }
        else
        {
            <div class="admin-table-wrapper">

                <table class="admin-table">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Staff</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Job Title</th>
                            <th>Shift</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            var counter = 1;
                        }

                        @foreach (var staff in Model)
                        {
                            <tr>

                                <td>
                                    <span class="staff-id">
                                        @counter
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center">

                                        <div class="staff-avatar me-3">
                                            <i class="fa fa-user"></i>
                                        </div>

                                        <div>
                                            <div class="staff-name">
                                                @(staff.User?.FullName ?? "Unknown")
                                            </div>

                                            <div class="staff-id">
                                                Staff ID #@staff.Id
                                            </div>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <span class="staff-username">
                                        @(staff.User?.UserName ?? "-")
                                    </span>
                                </td>

                                <td>
                                    <span class="staff-email">
                                        @(staff.User?.Email ?? "-")
                                    </span>
                                </td>

                                <td>
                                    <span class="staff-phone">
                                        @(staff.User?.PhoneNumber ?? "-")
                                    </span>
                                </td>

                                <td>
                                    <span class="job-badge">
                                        @staff.JobTitle
                                    </span>
                                </td>

                                <td>
                                    <span class="shift-text">
                                        @staff.ShiftTime
                                    </span>
                                </td>

                                <td>
                                    <div class="admin-actions">

                                        <a asp-controller="Staff"
                                           asp-action="Edit"
                                           asp-route-id="@staff.Id"
                                           class="admin-action admin-action-edit"
                                           title="Edit Staff">
                                            <i class="fa fa-pencil"></i>
                                        </a>

                                        <a asp-controller="Staff"
                                           asp-action="Delete"
                                           asp-route-id="@staff.Id"
                                           class="admin-action admin-action-delete"
                                           title="Delete Staff">
                                            <i class="fa fa-trash"></i>
                                        </a>

                                    </div>
                                </td>

                            </tr>

                            counter++;
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>
