
@model Y_GYM.Models.Staff

@{
    ViewData["Title"] = "Delete Staff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-delete-page {
        min-height: calc(100vh - 70px);
        padding: 90px 28px 40px;
        background: #101010;
        display: flex;
        align-items: flex-start;
        justify-content: center;
    }

    .delete-container {
        width: 100%;
        max-width: 650px;
    }

    .delete-card {
        margin-top: 20px;
        background: #151515;
        border: 1px solid #292929;
        border-radius: 14px;
        padding: 32px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, .25);
    }

    .delete-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: rgba(220, 53, 69, .12);
        border: 1px solid rgba(220, 53, 69, .3);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #dc3545;
        font-size: 25px;
        margin-bottom: 22px;
    }

    .delete-card h1 {
        margin: 0 0 10px;
        color: #ffffff;
        font-size: 28px;
        font-weight: 700;
    }

    .delete-description {
        margin: 0 0 28px;
        color: #929292;
        line-height: 1.7;
        font-size: 14px;
    }

    .staff-info {
        background: #101010;
        border: 1px solid #292929;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 28px;
    }

    .staff-info-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 11px 0;
        border-bottom: 1px solid #242424;
    }

    .staff-info-row:last-child {
        border-bottom: none;
    }

    .staff-info-label {
        color: #777777;
        font-size: 13px;
    }

    .staff-info-value {
        color: #eeeeee;
        font-size: 14px;
        font-weight: 500;
        text-align: right;
    }

    .warning {
        padding: 13px 15px;
        margin-bottom: 28px;
        border-radius: 8px;
        background: rgba(255, 140, 0, .08);
        border: 1px solid rgba(255, 140, 0, .22);
        color: #c9c9c9;
        font-size: 13px;
        line-height: 1.6;
    }

    .delete-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 22px;
        border-top: 1px solid #292929;
    }

    .btn-admin {
        min-width: 125px;
        min-height: 44px;
        padding: 9px 18px;
        border-radius: 8px;
        text-decoration: none;
        border: 1px solid transparent;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s ease;
    }

    .btn-cancel {
        background: #1d1d1d;
        color: #dddddd;
        border-color: #333333;
    }

    .btn-cancel:hover {
        background: #252525;
        color: #ffffff;
    }

    .btn-delete {
        background: #dc3545;
        color: #ffffff;
        border-color: #dc3545;
    }

    .btn-delete:hover {
        background: #bb2d3b;
        border-color: #bb2d3b;
    }

    @@media (max-width: 768px) {
        .admin-delete-page {
            padding: 85px 18px 30px;
        }

        .delete-card {
            padding: 23px;
        }

        .staff-info-row {
            flex-direction: column;
            gap: 4px;
        }

        .staff-info-value {
            text-align: left;
        }

        .delete-actions {
            flex-direction: column-reverse;
        }

        .btn-admin {
            width: 100%;
        }
    }
</style>

<div class="admin-delete-page">
    <div class="delete-container">

        <div class="delete-card">

            <div class="delete-icon">
                <i class="fas fa-trash"></i>
            </div>

            <h1>Delete Staff</h1>

            <p class="delete-description">
                Are you sure you want to delete this staff member?
                This action will remove the staff profile and associated account.
            </p>

            <div class="staff-info">

                <div class="staff-info-row">
                    <span class="staff-info-label">Name</span>
                    <span class="staff-info-value">
                        @Model.User?.FullName
                    </span>
                </div>

                <div class="staff-info-row">
                    <span class="staff-info-label">Username</span>
                    <span class="staff-info-value">
                        @Model.User?.UserName
                    </span>
                </div>

                <div class="staff-info-row">
                    <span class="staff-info-label">Email</span>
                    <span class="staff-info-value">
                        @Model.User?.Email
                    </span>
                </div>

                <div class="staff-info-row">
                    <span class="staff-info-label">Job Title</span>
                    <span class="staff-info-value">
                        @Model.JobTitle
                    </span>
                </div>

                <div class="staff-info-row">
                    <span class="staff-info-label">Shift</span>
                    <span class="staff-info-value">
                        @Model.ShiftTime
                    </span>
                </div>

            </div>

            <div class="warning">
                Please make sure this staff account is no longer needed before confirming deletion.
            </div>

            <form asp-controller="Staff" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.Id" />

                <div class="delete-actions">

                    <a asp-controller="Staff"
                       asp-action="Manage"
                       class="btn-admin btn-cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn-admin btn-delete">
                        Delete Staff
                    </button>

                </div>
            </form>

        </div>

    </div>
</div>