@model Y_Gem.Models.MembershipPlan

<div class="container mt-4">
    <h2 class="mb-4 text-dark">Add New Plan</h2>

    <form method="post" asp-controller="MembershipPlans" asp-action="SaveNew" class="col-md-6">

        <div class="mb-3">
            <label asp-for="Name" class="form-label text-secondary fw-bold">Plan Name</label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label text-secondary fw-bold">Plan Price</label>
            <input asp-for="Price" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="DurationDays" class="form-label text-secondary fw-bold">Duration</label>
            <input asp-for="DurationDays" class="form-control" />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-dark px-4">Save Plan</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2 px-4">Back</a>
        </div>

    </form>
</div>
