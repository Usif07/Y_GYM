
@model Y_GYM.Models.MembershipPlan

@{
    ViewData["Title"] = "Create Membership Plan";
}

<section class="gym-page">

    <div class="container">

        <!-- Page Header -->
        <div class="gym-page-header">

            <span class="page-label">
                FITNESS GYM
            </span>

            <h1>
                Create Membership Plan
            </h1>

            <p>
                Add a new membership plan with its price and duration.
            </p>

        </div>


        <!-- Form -->
        <div class="row justify-content-center">

            <div class="col-lg-8 col-md-10">

                <div class="gym-card">

                    <form asp-action="SaveNew"
                          method="post"
                          class="gym-form">

                        @Html.AntiForgeryToken()

                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-4">
                        </div>


                        <!-- Plan Name -->
                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label">
                                Plan Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter plan name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Price -->
                        <div class="mb-4">

                            <label asp-for="Price"
                                   class="form-label">
                                Price (EGP)
                            </label>

                            <input asp-for="Price"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="Enter plan price" />

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Duration -->
                        <div class="mb-4">

                            <label asp-for="DurationDays"
                                   class="form-label">
                                Duration (Days)
                            </label>

                            <input asp-for="DurationDays"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Enter duration in days" />

                            <span asp-validation-for="DurationDays"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="primary-btn gym-btn">

                                <i class="fa fa-save"></i>

                                Create Plan

                            </button>


                            <a asp-action="Index"
                               class="btn gym-btn-secondary">

                                <i class="fa fa-arrow-left"></i>

                                Back to Plans

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}