@model IEnumerable<Y_GYM.Models.MembershipPlan>

@{
    ViewData["Title"] = "Membership Plans";
}

<section class="gym-page">
    <div class="container">

        <div class="gym-page-header">
            <span class="page-label">FITNESS GYM</span>

            <h1>Membership Plans</h1>

            <p>
                Choose the membership plan that fits your training goals.
            </p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-4">
                <i class="fa fa-exclamation-circle me-2"></i>
                @TempData["Error"]
            </div>
        }

        @if (User.IsInRole("Admin"))
        {
            <div class="row mb-4">
                <div class="col-12">
                    <a asp-action="New"
                       class="primary-btn gym-btn">
                        <i class="fa fa-plus me-2"></i>
                        Create New Plan
                    </a>
                </div>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="gym-plan-card h-100">

                            <div class="gym-plan-icon">
                                <i class="fa fa-dumbbell"></i>
                            </div>

                            <div class="gym-plan-content">

                                <span class="gym-plan-label">
                                    FITNESS GYM
                                </span>

                                <h3>
                                    @item.Name
                                </h3>

                                <div class="gym-plan-price">
                                    @item.Price.ToString("0.00")
                                    <span>EGP</span>
                                </div>

                                <div class="gym-plan-duration">
                                    <i class="fa fa-calendar me-2"></i>
                                    @item.DurationDays days
                                </div>

                                <div class="gym-plan-divider"></div>

                                <p>
                                    Access FITNESS GYM services
                                    according to this membership plan.
                                </p>

                                <a asp-controller="Account"
                                   asp-action="Register"
                                   asp-route-planId="@item.Id"
                                   class="primary-btn gym-plan-btn">
                                    Choose This Plan
                                    <i class="fa fa-arrow-right ms-2"></i>
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="gym-plan-admin-actions">

                                        <a asp-action="Update"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-light">
                                            <i class="fa fa-edit me-1"></i>
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Are you sure you want to delete this plan?');">
                                            <i class="fa fa-trash me-1"></i>
                                            Delete
                                        </a>

                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                }

            </div>
        }
        else
        {
            <div class="gym-card">
                <div class="gym-empty text-center py-5">
                    <i class="fa fa-info-circle fa-2x mb-3"></i>

                    <p class="mb-0">
                        No membership plans found.
                    </p>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="New"
                           class="primary-btn gym-btn mt-4">
                            <i class="fa fa-plus me-2"></i>
                            Create First Plan
                        </a>
                    }
                </div>
            </div>
        }

    </div>
</section>