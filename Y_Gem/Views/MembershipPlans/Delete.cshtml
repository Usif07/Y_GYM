@model Y_GYM.Models.MembershipPlan

@{
    ViewData["Title"] = "Delete Membership Plan";
}

<section class="gym-page">
    <div class="container">

        <!-- Page Header -->
        <div class="gym-page-header">
            <span class="page-label">FITNESS GYM</span>

            <h1>Delete Membership Plan</h1>

            <p>
                Review the membership plan before deleting it.
            </p>
        </div>


        <div class="row justify-content-center">

            <div class="col-lg-7">

                <div class="gym-card">

                    <div class="text-center mb-4">

                        <div class="gym-plan-icon mx-auto mb-3">
                            <i class="fa fa-trash"></i>
                        </div>

                        <h3>
                            Delete Membership Plan?
                        </h3>

                        <p class="text-muted mb-0">
                            Are you sure you want to delete this membership plan?
                        </p>

                    </div>


                    <!-- Plan Information -->
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">

                            <div class="p-3 border rounded">

                                <small class="text-muted d-block mb-1">
                                    Plan Name
                                </small>

                                <strong>
                                    @Model.Name
                                </strong>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="p-3 border rounded">

                                <small class="text-muted d-block mb-1">
                                    Price
                                </small>

                                <strong>
                                    @Model.Price.ToString("0.00") EGP
                                </strong>

                            </div>

                        </div>


                        <div class="col-12">

                            <div class="p-3 border rounded">

                                <small class="text-muted d-block mb-1">
                                    Duration
                                </small>

                                <strong>
                                    @Model.DurationDays days
                                </strong>

                            </div>

                        </div>

                    </div>


                    <div class="alert alert-warning">

                        <i class="fa fa-exclamation-triangle me-2"></i>

                        This action cannot be undone.

                    </div>


                    <!-- Delete Form -->
                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />


                        <div class="d-flex gap-2 flex-wrap">

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="fa fa-trash me-2"></i>

                                Delete Plan

                            </button>


                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="fa fa-arrow-left me-2"></i>

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
</section>