@model Y_GYM.Models.Subscription

@{
    ViewData["Title"] = "Subscription Details";

    string statusClass = Model.Status switch
    {
        "Active" => "bg-success",
        "Expired" => "bg-danger",
        "Pending" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

<div class="gym-page">

    <div class="gym-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">

        <div>

            <h1>
                <i class="fas fa-id-card me-2"></i>
                Subscription Details
            </h1>

            <p class="text-muted mb-0">
                Subscription #@Model.Id
            </p>

        </div>

        <span class="badge @statusClass fs-6 px-3 py-2">
            @Model.Status
        </span>

    </div>


    <div class="gym-card">

        <div class="row g-0">

            <div class="col-md-6 gym-details-row">

                <div class="gym-details-label">
                    Subscription ID
                </div>

                <div class="gym-details-value">
                    #@Model.Id
                </div>

            </div>


            <div class="col-md-6 gym-details-row">

                <div class="gym-details-label">
                    Member
                </div>

                <div class="gym-details-value">
                    @(Model.Member?.FullName ?? "Unknown Member")
                </div>

            </div>


            <div class="col-md-6 gym-details-row">

                <div class="gym-details-label">
                    Membership Plan
                </div>

                <div class="gym-details-value">
                    @(Model.MembershipPlan?.Name ?? "No Plan")
                </div>

            </div>


            <div class="col-md-6 gym-details-row">

                <div class="gym-details-label">
                    Plan Price
                </div>

                <div class="gym-details-value">

                    @if (Model.MembershipPlan != null)
                    {
                        @Model.MembershipPlan.Price.ToString("N2")
                    }
                    else
                    {
                        <span>N/A</span>
                    }

                </div>

            </div>


            <div class="col-md-6 gym-details-row">

                <div class="gym-details-label">
                    Duration
                </div>

                <div class="gym-details-value">

                    @if (Model.MembershipPlan != null)
                    {
                        @Model.MembershipPlan.DurationDays
                        @:days
                    }
                    else
                    {
                        <span>N/A</span>
                    }

                </div>

            </div>


            <div class="col-md-6 gym-details-row">

                <div class="gym-details-label">
                    Status
                </div>

                <div class="gym-details-value">

                    <span class="badge @statusClass">
                        @Model.Status
                    </span>

                </div>

            </div>


            <div class="col-md-6 gym-details-row">

                <div class="gym-details-label">
                    Start Date
                </div>

                <div class="gym-details-value">
                    @Model.StartDate.ToString("dd/MM/yyyy")
                </div>

            </div>


            <div class="col-md-6 gym-details-row">

                <div class="gym-details-label">
                    End Date
                </div>

                <div class="gym-details-value">
                    @Model.EndDate.ToString("dd/MM/yyyy")
                </div>

            </div>

        </div>


        <hr class="my-4" />


        <div class="d-flex gap-2 flex-wrap">

            <a asp-action="Renew"
               asp-route-id="@Model.Id"
               class="btn btn-success">

                <i class="fas fa-sync-alt me-2"></i>
                Renew

            </a>


            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn gym-btn">

                <i class="fas fa-edit me-2"></i>
                Edit

            </a>


            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger">

                    <i class="fas fa-trash me-2"></i>
                    Delete

                </a>
            }


            <a asp-action="Index"
               class="btn gym-btn-secondary">

                <i class="fas fa-arrow-left me-2"></i>
                Back

            </a>

        </div>

    </div>

</div>