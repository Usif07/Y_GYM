@model Y_GYM.Models.Subscription

@{
    ViewData["Title"] = "Edit Subscription";
}

<div class="gym-page">

    <div class="gym-page-header">

        <h1>
            <i class="fas fa-edit me-2"></i>
            Edit Subscription
        </h1>

        <p class="text-muted mb-0">
            Update the member, plan, or start date.
        </p>

    </div>


    <div class="gym-card">

        <form asp-action="Edit"
              method="post"
              class="gym-form">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4">
            </div>


            <div class="row g-4">

                <div class="col-md-6">

                    <label asp-for="MemberId"
                           class="form-label">
                        Member
                    </label>

                    <select asp-for="MemberId"
                            asp-items="ViewBag.Members"
                            class="form-select">

                        <option value="">
                            -- Select Member --
                        </option>

                    </select>

                    <span asp-validation-for="MemberId"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="PlanId"
                           class="form-label">
                        Membership Plan
                    </label>

                    <select asp-for="PlanId"
                            asp-items="ViewBag.Plans"
                            class="form-select">

                        <option value="">
                            -- Select Membership Plan --
                        </option>

                    </select>

                    <span asp-validation-for="PlanId"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="StartDate"
                           class="form-label">
                        Start Date
                    </label>

                    <input asp-for="StartDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="StartDate"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6">

                    <label class="form-label">
                        Current End Date
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.EndDate.ToString("dd/MM/yyyy")"
                           readonly />

                    <small class="text-muted">
                        End date will be recalculated from the selected plan.
                    </small>

                </div>

            </div>


            <hr class="my-4" />


            <div class="d-flex gap-2 flex-wrap">

                <button type="submit"
                        class="btn gym-btn">

                    <i class="fas fa-save me-2"></i>
                    Save Changes

                </button>


                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn gym-btn-secondary">

                    <i class="fas fa-eye me-2"></i>
                    Details

                </a>


                <a asp-action="Index"
                   class="btn gym-btn-secondary">

                    <i class="fas fa-arrow-left me-2"></i>
                    Back

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}