@model IEnumerable<Y_GYM.Models.CheckIn>

@{
    ViewData["Title"] = "Check Ins";
}

<div class="gym-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="gym-page-header">

        <div>
            <h1>Check Ins</h1>
            <p>Track member attendance and subscription access.</p>
        </div>

        <a asp-action="Create"
           class="btn gym-btn">
            <i class="bi bi-plus-circle me-1"></i>
            New Check In
        </a>

    </div>

    <!-- Statistics -->

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="gym-card h-100">
                <div class="text-muted">Total Check Ins</div>
                <div class="fs-3 fw-bold">
                    @ViewBag.TotalCheckIns
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="gym-card h-100">
                <div class="text-muted">Today</div>
                <div class="fs-3 fw-bold">
                    @ViewBag.TodayCheckIns
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="gym-card h-100">
                <div class="text-muted">Allowed</div>
                <div class="fs-3 fw-bold text-success">
                    @ViewBag.AllowedCheckIns
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="gym-card h-100">
                <div class="text-muted">Rejected</div>
                <div class="fs-3 fw-bold text-danger">
                    @ViewBag.RejectedCheckIns
                </div>
            </div>
        </div>

    </div>

    <!-- Table -->

    <div class="gym-card">

        <div class="table-responsive">

            <table class="table gym-table align-middle">

                <thead>
                    <tr>

                        <th>Member</th>

                        <th>Staff</th>

                        <th>Check In Time</th>

                        <th>Status</th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5"
                                class="text-center py-5">

                                <div class="gym-empty">
                                    <div class="fs-4 mb-2">
                                        No check-ins found.
                                    </div>

                                    <div class="text-muted">
                                        Create the first check-in to start
                                        tracking attendance.
                                    </div>
                                </div>

                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.Member?.FullName
                                    </strong>
                                </td>

                                <td>
                                    @item.Staff?.User?.FullName
                                </td>

                                <td>
                                    @item.CheckInTime.ToString(
                                        "dd/MM/yyyy HH:mm")
                                </td>

                                <td>

                                    @if (item.Status == "Allowed")
                                    {
                                        <span class="badge bg-success">
                                            Allowed
                                        </span>
                                    }
                                    else if (item.Status == "Rejected-Expired")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected - Expired
                                        </span>
                                    }
                                    else if (item.Status == "Rejected-Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Rejected - Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>