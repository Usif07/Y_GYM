
@model Y_GYM.Models.CheckIn

@{
    ViewData["Title"] = "Delete Check In";
}

<h1>Delete Check In</h1>

<h3>Are you sure you want to delete this?</h3>

<div>

    <h4>Check In</h4>

    <hr />

    <dl>

        <dt>
            Member
        </dt>

        <dd>
            @Model.Member?.FullName
        </dd>


        <dt>
            Staff
        </dt>

        <dd>
            @Model.Staff?.User?.FullName
        </dd>


        <dt>
            @Html.DisplayNameFor(model => model.CheckInTime)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CheckInTime)
        </dd>


        <dt>
            @Html.DisplayNameFor(model => model.Status)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Status)
        </dd>

    </dl>


    <form asp-action="Delete" method="post">

        <input type="hidden"
               asp-for="Id" />

        <input type="submit"
               value="Delete" />

        <a asp-action="Index">
            Back to List
        </a>

    </form>

</div>
