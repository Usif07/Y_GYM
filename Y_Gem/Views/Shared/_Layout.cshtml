@using Microsoft.AspNetCore.Identity
@using Y_GYM.Models

@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - FITNESS GYM
    </title>


    <!-- Google Fonts -->

    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Muli:wght@400;500;600;700&display=swap"
          rel="stylesheet" />


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/css/bootstrap.min.css" />


    <!-- Template CSS -->

    <link rel="stylesheet"
          href="~/css/font-awesome.min.css" />

    <link rel="stylesheet"
          href="~/css/flaticon.css" />

    <link rel="stylesheet"
          href="~/css/owl.carousel.min.css" />

    <link rel="stylesheet"
          href="~/css/barfiller.css" />

    <link rel="stylesheet"
          href="~/css/magnific-popup.css" />

    <link rel="stylesheet"
          href="~/css/slicknav.min.css" />

    <link rel="stylesheet"
          href="~/css/style.css" />


    <!-- FITNESS GYM Custom CSS -->

    <link rel="stylesheet"
          href="~/css/fitness-gym.css" />


    @await RenderSectionAsync(
        "Styles",
        required: false)

</head>


<body>


    <!-- ========================================= -->
    <!-- Preloader -->
    <!-- ========================================= -->

    <div id="preloder">

        <div class="loader"></div>

    </div>


    <div class="offcanvas-menu-overlay"></div>


    <!-- ========================================= -->
    <!-- Mobile Menu -->
    <!-- ========================================= -->

    <div class="offcanvas-menu-wrapper">


        <div class="canvas-close">

            <i class="fa fa-close"></i>

        </div>


        <nav class="canvas-menu mobile-menu">

            <ul>


                <!-- Home -->

                <li>

                    <a asp-controller="Home"
                       asp-action="Index">

                        Home

                    </a>

                </li>


                <!-- About -->

                <li>

                    <a href="@Url.Action("Index", "Home")#about">

                        About

                    </a>

                </li>


                <!-- Memberships -->

                <li>

                    <a asp-controller="MembershipPlans"
                       asp-action="Index">

                        Memberships

                    </a>

                </li>


                <!-- Classes -->

                <li>

                    <a asp-controller="Class"
                       asp-action="Index">

                        Classes

                    </a>

                </li>


                <!-- Trainers -->

                <li>

                    <a asp-controller="Coach"
                       asp-action="Index">

                        Trainers

                    </a>

                </li>


                <!-- Services -->

                <li>

                    <a href="@Url.Action("Index", "Home")#services">

                        Services

                    </a>

                </li>


                <!-- Contact -->

                <li>

                    <a href="@Url.Action("Index", "Home")#contact">

                        Contact

                    </a>

                </li>


                <!-- ================================= -->
                <!-- Mobile Account Area -->
                <!-- ================================= -->
                @if (User.Identity?.IsAuthenticated == true)
                {

                    <li>

                        <a href="#"
                           class="mobile-account-title">

                            <i class="fa fa-user-circle me-2"></i>

                            @(User.Identity.Name ?? "Account")

                        </a>

                    </li>


                    <!-- Admin -->
                    @if (User.IsInRole("Admin"))
                    {

                        <li>

                            <a asp-controller="Admin"
                               asp-action="Index">

                                <i class="fa fa-dashboard me-2"></i>

                                Admin Dashboard

                            </a>

                        </li>

                    }


                    <!-- Staff -->
                    @if (User.IsInRole("Staff"))
                    {

                        <li>

                            <a asp-controller="Staff"
                               asp-action="Index">

                                <i class="fa fa-dashboard me-2"></i>

                                Staff Dashboard

                            </a>

                        </li>

                    }


                    <!-- Trainer -->
                    @if (User.IsInRole("Trainer"))
                    {

                        <li>

                            <a asp-controller="Coach"
                               asp-action="Index">

                                <i class="fa fa-dashboard me-2"></i>

                                Trainer Dashboard

                            </a>

                        </li>

                    }


                    <!-- Member -->
                    @if (User.IsInRole("Member"))
                    {

                        <li>

                            <a asp-controller="Member"
                               asp-action="Index">

                                <i class="fa fa-dashboard me-2"></i>

                                My Dashboard

                            </a>

                        </li>

                    }


                    <!-- Logout -->

                    <li>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="mobile-logout-form">

                            @Html.AntiForgeryToken()


                            <button type="submit"
                                    class="mobile-logout-button">

                                <i class="fa fa-sign-out me-2"></i>

                                Logout

                            </button>

                        </form>

                    </li>

                }
                else
                {

                    <!-- Login -->

                    <li>

                        <a asp-controller="Account"
                           asp-action="Login">

                            <i class="fa fa-sign-in me-2"></i>

                            Login

                        </a>

                    </li>


                    <!-- Register -->

                    <li>

                        <a asp-controller="Account"
                           asp-action="Register">

                            <i class="fa fa-user-plus me-2"></i>

                            Register

                        </a>

                    </li>

                }

            </ul>

        </nav>


        <!-- Mobile Social -->

        <div class="canvas-social">

            <a href="#"
               aria-label="Facebook">

                <i class="fa fa-facebook"></i>

            </a>


            <a href="#"
               aria-label="Instagram">

                <i class="fa fa-instagram"></i>

            </a>


            <a href="#"
               aria-label="YouTube">

                <i class="fa fa-youtube-play"></i>

            </a>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- Header -->
    <!-- ========================================= -->

    <header class="header-section">


        <div class="container-fluid">


            <div class="row align-items-center">


                <!-- ================================= -->
                <!-- Logo -->
                <!-- ================================= -->

                <div class="col-lg-3 col-md-3 col-8">


                    <div class="logo">


                        <a asp-controller="Home"
                           asp-action="Index"
                           class="text-decoration-none">


                            <span style="font-size:30px;font-weight:800;color:#f36100;">

                                FITNESS

                            </span>


                            <span style="font-size:30px;font-weight:800;color:#ffffff;">

                                GYM

                            </span>


                        </a>


                    </div>


                </div>


                <!-- ================================= -->
                <!-- Desktop Navigation -->
                <!-- ================================= -->

                <div class="col-lg-6 col-md-6 d-none d-lg-block">


                    <nav class="nav-menu">


                        <ul>


                            <!-- Home -->

                            <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">


                                <a asp-controller="Home"
                                   asp-action="Index">

                                    Home

                                </a>


                            </li>


                            <!-- About -->

                            <li>


                                <a href="@Url.Action("Index", "Home")#about">

                                    About

                                </a>


                            </li>


                            <!-- Memberships -->

                            <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "MembershipPlans" ? "active" : "")">


                                <a asp-controller="MembershipPlans"
                                   asp-action="Index">

                                    Memberships

                                </a>


                            </li>


                            <!-- Classes -->

                            <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Class" ? "active" : "")">


                                <a asp-controller="Class"
                                   asp-action="Index">

                                    Classes

                                </a>


                            </li>


                            <!-- Trainers -->

                            <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Coach" ? "active" : "")">


                                <a asp-controller="Coach"
                                   asp-action="Index">

                                    Trainers

                                </a>


                            </li>


                            <!-- Services -->

                            <li>


                                <a href="@Url.Action("Index", "Home")#services">

                                    Services

                                </a>


                            </li>


                        </ul>


                    </nav>


                </div>


                <!-- ================================= -->
                <!-- Right Side -->
                <!-- ================================= -->

                <div class="col-lg-3 col-md-3 col-4">


                    <div class="top-option d-flex align-items-center justify-content-end gap-3">


                        <!-- ================================= -->
                        <!-- AUTHENTICATED USER -->
                        <!-- ================================= -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {

                            <div class="dropdown d-none d-md-block">


                                <!-- Account Button -->

                                <button class="btn fitness-user-dropdown-button dropdown-toggle"
                                        type="button"
                                        id="fitnessAccountDropdown"
                                        data-bs-toggle="dropdown"
                                        data-bs-display="static"
                                        aria-expanded="false">


                                    <span class="fitness-user-icon">

                                        <i class="fa fa-user-circle"></i>

                                    </span>


                                    <span class="fitness-user-name">

                                        @(User.Identity.Name ?? "Account")

                                    </span>


                                </button>


                                <!-- ================================= -->
                                <!-- Dropdown -->
                                <!-- ================================= -->

                                <ul class="dropdown-menu dropdown-menu-end fitness-account-dropdown"
                                    aria-labelledby="fitnessAccountDropdown">


                                    <!-- Account Header -->

                                    <li>

                                        <div class="fitness-dropdown-header">


                                            <div class="fitness-dropdown-avatar">

                                                <i class="fa fa-user"></i>

                                            </div>


                                            <div>

                                                <strong>
                                                    @(User.Identity.Name ?? "Account")
                                                </strong>


                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <small>Administrator</small>
                                                }
                                                else if (User.IsInRole("Staff"))
                                                {
                                                    <small>Staff</small>
                                                }
                                                else if (User.IsInRole("Trainer"))
                                                {
                                                    <small>Trainer</small>
                                                }
                                                else if (User.IsInRole("Member"))
                                                {
                                                    <small>Member</small>
                                                }

                                            </div>

                                        </div>

                                    </li>


                                    <li>

                                        <hr class="dropdown-divider" />

                                    </li>


                                    <!-- ================================= -->
                                    <!-- Admin Dashboard -->
                                    <!-- ================================= -->
                                    @if (User.IsInRole("Admin"))
                                    {

                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Admin"
                                               asp-action="Index">

                                                <i class="fa fa-dashboard me-2"></i>

                                                Admin Dashboard

                                            </a>

                                        </li>

                                    }


                                    <!-- ================================= -->
                                    <!-- Staff Dashboard -->
                                    <!-- ================================= -->
                                    @if (User.IsInRole("Staff"))
                                    {

                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Staff"
                                               asp-action="Index">

                                                <i class="fa fa-dashboard me-2"></i>

                                                Staff Dashboard

                                            </a>

                                        </li>

                                    }


                                    <!-- ================================= -->
                                    <!-- Trainer Dashboard -->
                                    <!-- ================================= -->
                                    @if (User.IsInRole("Trainer"))
                                    {

                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Coach"
                                               asp-action="Index">

                                                <i class="fa fa-dashboard me-2"></i>

                                                Trainer Dashboard

                                            </a>

                                        </li>

                                    }


                                    <!-- ================================= -->
                                    <!-- Member Dashboard -->
                                    <!-- ================================= -->
                                    @if (User.IsInRole("Member"))
                                    {

                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Member"
                                               asp-action="Index">

                                                <i class="fa fa-dashboard me-2"></i>

                                                My Dashboard

                                            </a>

                                        </li>

                                    }


                                    <li>

                                        <hr class="dropdown-divider" />

                                    </li>


                                    <!-- ================================= -->
                                    <!-- Logout -->
                                    <!-- ================================= -->

                                    <li>

                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post"
                                              class="m-0">


                                            @Html.AntiForgeryToken()


                                            <button type="submit"
                                                    class="dropdown-item fitness-logout-item">


                                                <i class="fa fa-sign-out me-2"></i>


                                                Logout


                                            </button>


                                        </form>

                                    </li>


                                </ul>


                            </div>

                        }
                        else
                        {

                            <!-- ================================= -->
                            <!-- Login -->
                            <!-- ================================= -->

                            <a asp-controller="Account"
                               asp-action="Login"
                               class="fitness-account-link fitness-login-link d-none d-md-inline-flex align-items-center">


                                <i class="fa fa-sign-in"></i>


                                <span>

                                    Login

                                </span>


                            </a>


                            <!-- ================================= -->
                            <!-- Register -->
                            <!-- ================================= -->

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="fitness-account-link fitness-register-link d-none d-md-inline-flex align-items-center">


                                <i class="fa fa-user-plus"></i>


                                <span>

                                    Register

                                </span>


                            </a>

                        }


                        <!-- ================================= -->
                        <!-- Search -->
                        <!-- ================================= -->

                        <div class="to-search search-switch"
                             role="button"
                             aria-label="Open search">


                            <i class="fa fa-search"></i>


                        </div>


                        <!-- ================================= -->
                        <!-- Social -->
                        <!-- ================================= -->

                        <div class="to-social d-none d-md-block">


                            <a href="#"
                               aria-label="Facebook">

                                <i class="fa fa-facebook"></i>

                            </a>


                            <a href="#"
                               aria-label="Instagram">

                                <i class="fa fa-instagram"></i>

                            </a>


                            <a href="#"
                               aria-label="YouTube">

                                <i class="fa fa-youtube-play"></i>

                            </a>


                        </div>


                    </div>


                </div>


            </div>


            <!-- ================================= -->
            <!-- Mobile Menu Button -->
            <!-- ================================= -->

            <div class="canvas-open d-lg-none">


                <i class="fa fa-bars"></i>


            </div>


        </div>


    </header>


    <!-- ========================================= -->
    <!-- Main Content -->
    <!-- ========================================= -->

    <main class="gym-main">

        @RenderBody()

    </main>


    <!-- ========================================= -->
    <!-- Get In Touch -->
    <!-- ========================================= -->

    <div class="gettouch-section">


        <div class="container">


            <div class="row g-4">


                <!-- Location -->

                <div class="col-lg-4 col-md-4 col-sm-12">


                    <div class="gt-text h-100">


                        <i class="fa fa-map-marker"></i>


                        <p class="mb-0">

                            Fayoum, Egypt

                        </p>


                    </div>


                </div>


                <!-- Phone -->

                <div class="col-lg-4 col-md-4 col-sm-12">


                    <div class="gt-text h-100">


                        <i class="fa fa-mobile"></i>


                        <ul class="mb-0">


                            <li>


                                <a href="tel:+20235355656"
                                   class="text-decoration-none text-white">

                                    +20 2 35355656

                                </a>


                            </li>


                        </ul>


                    </div>


                </div>


                <!-- Email -->

                <div class="col-lg-4 col-md-4 col-sm-12">


                    <div class="gt-text email h-100">


                        <i class="fa fa-envelope"></i>


                        <p class="mb-0">


                            <a href="mailto:ITIinfo@iti.gov.eg"
                               class="text-decoration-none text-white">

                                ITIinfo@iti.gov.eg

                            </a>


                        </p>


                    </div>


                </div>


            </div>


        </div>


    </div>


    <!-- ========================================= -->
    <!-- Footer -->
    <!-- ========================================= -->

    <footer class="footer-section">


        <div class="container">


            <div class="row g-4">


                <!-- About -->

                <div class="col-lg-4 col-md-6">


                    <div class="fs-about">


                        <div class="fa-logo">


                            <a asp-controller="Home"
                               asp-action="Index"
                               class="text-decoration-none">


                                <span style="font-size:28px;font-weight:800;color:#f36100;">

                                    FITNESS

                                </span>


                                <span style="font-size:28px;font-weight:800;color:#ffffff;">

                                    GYM

                                </span>


                            </a>


                        </div>


                        <p>

                            FITNESS GYM is a complete gym management system
                            for memberships, bookings, attendance, training,
                            and nutrition plans.

                        </p>


                        <div class="fa-social">


                            <a href="#"
                               aria-label="Facebook">

                                <i class="fa fa-facebook"></i>

                            </a>


                            <a href="#"
                               aria-label="Instagram">

                                <i class="fa fa-instagram"></i>

                            </a>


                            <a href="#"
                               aria-label="YouTube">

                                <i class="fa fa-youtube-play"></i>

                            </a>


                        </div>


                    </div>


                </div>


                <!-- Quick Links -->

                <div class="col-lg-2 col-md-3 col-sm-6">


                    <div class="fs-widget">


                        <h4>

                            Quick Links

                        </h4>


                        <ul>


                            <li>

                                <a asp-controller="Home"
                                   asp-action="Index">

                                    Home

                                </a>

                            </li>


                            <li>

                                <a href="@Url.Action("Index", "Home")#about">

                                    About

                                </a>

                            </li>


                            <li>

                                <a asp-controller="MembershipPlans"
                                   asp-action="Index">

                                    Memberships

                                </a>

                            </li>


                            <li>

                                <a asp-controller="Class"
                                   asp-action="Index">

                                    Classes

                                </a>

                            </li>


                            <li>

                                <a asp-controller="Coach"
                                   asp-action="Index">

                                    Trainers

                                </a>

                            </li>


                            <li>

                                <a href="@Url.Action("Index", "Home")#contact">

                                    Contact

                                </a>

                            </li>


                        </ul>


                    </div>


                </div>


                <!-- Member Area -->

                <div class="col-lg-2 col-md-3 col-sm-6">


                    <div class="fs-widget">


                        <h4>

                            Member Area

                        </h4>


                        <ul>


                            <li>

                                <a asp-controller="Member"
                                   asp-action="Index">

                                    My Dashboard

                                </a>

                            </li>


                            <li>

                                <a asp-controller="Member"
                                   asp-action="Schedule">

                                    Class Schedule

                                </a>

                            </li>


                            <li>

                                <a asp-controller="Member"
                                   asp-action="MyBookings">

                                    My Bookings

                                </a>

                            </li>


                            <li>

                                <a asp-controller="Member"
                                   asp-action="Progress">

                                    My Progress

                                </a>

                            </li>


                            <li>

                                <a asp-controller="Subscription"
                                   asp-action="Index">

                                    Subscriptions

                                </a>

                            </li>


                        </ul>


                    </div>


                </div>


                <!-- Contact / Gym -->

                <div class="col-lg-4 col-md-6">


                    <div class="fs-widget">


                        <h4>

                            FITNESS GYM

                        </h4>


                        <p>

                            Your place to train, track your progress,
                            manage your membership, and stay committed
                            to your fitness goals.

                        </p>


                        <p class="mb-2">


                            <i class="fa fa-phone me-2"></i>


                            <a href="tel:+20235355656"
                               class="text-decoration-none text-white">

                                +20 2 35355656

                            </a>


                        </p>


                        <p class="mb-3">


                            <i class="fa fa-envelope me-2"></i>


                            <a href="mailto:ITIinfo@iti.gov.eg"
                               class="text-decoration-none text-white">

                                ITIinfo@iti.gov.eg

                            </a>


                        </p>


                        <div class="mt-3">


                            <a class="btn btn-outline-light px-4"
                               asp-controller="MembershipPlans"
                               asp-action="Index">

                                View Memberships

                            </a>


                        </div>


                    </div>


                </div>


            </div>


            <!-- Copyright -->

            <div class="row mt-4">


                <div class="col-lg-12 text-center">


                    <div class="copyright-text">


                        <p class="mb-0">

                            © @DateTime.Now.Year FITNESS GYM -
                            All Rights Reserved

                        </p>


                    </div>


                </div>


            </div>


        </div>


    </footer>


    <!-- ========================================= -->
    <!-- Search -->
    <!-- ========================================= -->

    <div class="search-model">


        <div class="h-100 d-flex align-items-center justify-content-center">


            <div class="search-close-switch">

                +

            </div>


            <form class="search-model-form">


                <input type="text"
                       id="search-input"
                       placeholder="Search here..."
                       autocomplete="off" />


            </form>


        </div>


    </div>


    <!-- ========================================= -->
    <!-- Scripts -->
    <!-- ========================================= -->

    <script src="~/js/jquery-3.3.1.min.js"></script>

   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>




    <script src="~/js/jquery.magnific-popup.min.js"></script>

    <script src="~/js/masonry.pkgd.min.js"></script>

    <script src="~/js/jquery.barfiller.js"></script>

    <script src="~/js/jquery.slicknav.js"></script>

    <script src="~/js/owl.carousel.min.js"></script>

    <script src="~/js/main.js"></script>


    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>