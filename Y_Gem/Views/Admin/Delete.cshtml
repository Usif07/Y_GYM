
@model Y_GYM.Models.Admin

@{
    ViewData["Title"] = "Delete Admin";
}

<h1>Delete Admin</h1>

<h3>Are you sure you want to delete this admin?</h3>

<hr />

<dl>
    <dt>Full Name</dt>
    <dd>@Model.FullName</dd>

    <dt>User Name</dt>
    <dd>@Model.UserName</dd>

    <dt>Email</dt>
    <dd>@Model.Email</dd>

    <dt>Phone Number</dt>
    <dd>@Model.PhoneNumber</dd>
</dl>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <input type="submit" value="Delete" />

    <a asp-action="Index">Back to List</a>

</form>