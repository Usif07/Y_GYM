@model IEnumerable<Y_GYM.Models.Coach>

@{
    ViewData["Title"] = "Our Trainers";
}

<section class="gym-page">

    <div class="container">

        <!-- Header -->
        <div class="gym-page-header">

            <span class="page-label">
                OUR TEAM
            </span>

            <h1>
                Our Trainers
            </h1>

            <p>
                Meet our professional trainers and explore their specialties.
            </p>

        </div>


        <!-- Trainers -->
        <div class="row g-4">

            @if (Model != null && Model.Any())
            {
                foreach (var coach in Model)
                {
                    <div class="col-xl-4 col-md-6">

                        <div class="admin-dashboard-card h-100">

                            <div class="admin-card-heading">

                                <div>

                                    <span>
                                        TRAINER
                                    </span>

                                    <h3>
                                        @coach.User?.FullName
                                    </h3>

                                </div>

                                <i class="fa fa-user-md"></i>

                            </div>


                            <div class="mt-3">

                                <p class="mb-2">
                                    <strong>
                                        Specialty
                                    </strong>
                                </p>

                                <p class="text-white-50 mb-4">
                                    @coach.CoachSpecialty
                                </p>


                                <a asp-controller="Coach"
                                   asp-action="Details"
                                   asp-route-id="@coach.Id"
                                   class="btn btn-outline-light btn-sm">

                                    View Profile

                                    <i class="fa fa-arrow-right ms-2"></i>

                                </a>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="admin-dashboard-card text-center">

                        <i class="fa fa-users fa-2x mb-3"></i>

                        <h3>
                            No Trainers Available
                        </h3>

                        <p class="text-white-50 mb-0">
                            Trainer information will appear here once trainers are added.
                        </p>

                    </div>

                </div>
            }

        </div>

    </div>

</section>