@model Y_GYM.Models.Class

@{
    ViewData["Title"] = "Edit Class";
}

<section class="gym-page">

    <div class="container">

        <div class="gym-page-header">

            <span class="page-label">
                FITNESS GYM
            </span>

            <h1>
                Edit Class
            </h1>

            <p>
                Update the class information.
            </p>

        </div>


        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="gym-card">

                    <form asp-action="Edit"
                          method="post"
                          class="gym-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-4">
                        </div>


                        <!-- Name -->
                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label">

                                Class Name

                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter class name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Capacity -->
                        <div class="mb-4">

                            <label asp-for="Capacity"
                                   class="form-label">

                                Capacity

                            </label>

                            <input asp-for="Capacity"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Enter maximum capacity" />

                            <span asp-validation-for="Capacity"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="primary-btn gym-btn">

                                <i class="fa fa-save me-2"></i>

                                Save Changes

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-light">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}