@model IEnumerable<Y_GYM.Models.Coach>

@{
    ViewData["Title"] = "Manage Trainers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-page {
        min-height: calc(100vh - 70px);
        padding: 90px 28px 40px;
        background: #101010;
    }

    .admin-container {
        max-width: 1250px;
        margin: 0 auto;
    }

    .admin-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 35px;
        margin-bottom: 32px;
        padding: 0 5px;
    }

    .admin-page-title h1 {
        margin: 0 0 8px;
        color: #ffffff;
        font-size: 30px;
        font-weight: 700;
    }

    .admin-page-title p {
        margin: 0;
        color: #929292;
        font-size: 14px;
    }

    .btn-add {
        flex-shrink: 0;
        min-width: 140px;
        min-height: 44px;
        padding: 10px 18px;
        border-radius: 8px;
        background: #ff8c00;
        border: 1px solid #ff8c00;
        color: #111111;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        text-align: center;
        white-space: nowrap;
        transition: .2s ease;
    }

    .btn-add:hover {
        background: #ff9d22;
        border-color: #ff9d22;
        color: #111111;
    }

    .admin-card {
        background: #151515;
        border: 1px solid #292929;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, .25);
    }

    .admin-table-wrapper {
        overflow-x: auto;
    }

    .admin-table {
        width: 100%;
        min-width: 850px;
        border-collapse: collapse;
        margin: 0;
    }

    .admin-table thead {
        background: #191919;
    }

    .admin-table th {
        padding: 17px 18px;
        color: #8f8f8f;
        border-bottom: 1px solid #292929;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .4px;
        text-align: left;
        white-space: nowrap;
    }

    .admin-table td {
        padding: 18px;
        color: #dddddd;
        border-bottom: 1px solid #242424;
        font-size: 14px;
        vertical-align: middle;
    }

    .admin-table tbody tr {
        transition: background .2s ease;
    }

    .admin-table tbody tr:hover {
        background: #1a1a1a;
    }

    .admin-table tbody tr:last-child td {
        border-bottom: none;
    }

    .trainer-name {
        color: #ffffff;
        font-weight: 600;
    }

    .trainer-username {
        color: #777777;
        font-size: 12px;
        margin-top: 4px;
    }

    .specialty {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 6px;
        background: rgba(255, 140, 0, .08);
        border: 1px solid rgba(255, 140, 0, .18);
        color: #ff9d22;
        font-size: 12px;
    }

    .action-group {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 68px;
        height: 34px;
        padding: 5px 10px;
        border-radius: 6px;
        border: 1px solid #333333;
        background: #1d1d1d;
        color: #cccccc;
        text-decoration: none;
        font-size: 12px;
        font-weight: 500;
        transition: .2s ease;
    }

    .action-btn:hover {
        background: #262626;
        color: #ffffff;
        border-color: #444444;
    }

    .action-edit:hover {
        color: #ff9d22;
        border-color: rgba(255, 140, 0, .4);
    }

    .action-delete:hover {
        color: #ff5c6c;
        border-color: rgba(220, 53, 69, .4);
    }

    .empty-state {
        padding: 65px 25px;
        text-align: center;
    }

    .empty-state-icon {
        color: #555555;
        font-size: 35px;
        margin-bottom: 15px;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: #dddddd;
        font-size: 18px;
    }

    .empty-state p {
        margin: 0;
        color: #777777;
        font-size: 14px;
    }

    .alert-success {
        margin-bottom: 25px;
        padding: 13px 16px;
        border-radius: 8px;
        background: rgba(25, 135, 84, .10);
        border: 1px solid rgba(25, 135, 84, .25);
        color: #75d7a6;
        font-size: 14px;
    }

    .alert-danger {
        margin-bottom: 25px;
        padding: 13px 16px;
        border-radius: 8px;
        background: rgba(220, 53, 69, .10);
        border: 1px solid rgba(220, 53, 69, .25);
        color: #ff7b87;
        font-size: 14px;
    }

    @@media (max-width: 768px) {
        .admin-page {
            padding: 85px 18px 30px;
        }

        .admin-page-header {
            flex-direction: column;
            align-items: stretch;
            gap: 18px;
            margin-bottom: 25px;
        }

        .admin-page-title h1 {
            font-size: 25px;
        }

        .btn-add {
            width: 100%;
        }

        .admin-card {
            border-radius: 10px;
        }
    }
</style>

<div class="admin-page">
    <div class="admin-container">

        <div class="admin-page-header">
            <div class="admin-page-title">
                <h1>Manage Trainers</h1>
                <p>Manage trainer accounts, specialties and profiles.</p>
            </div>

            <a asp-controller="Coach"
               asp-action="Create"
               class="btn-add">
                <i class="fas fa-plus"></i>
                Add Trainer
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="admin-card">

            @if (Model != null && Model.Any())
            {
                <div class="admin-table-wrapper">

                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Trainer</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Specialty</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var coach in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="trainer-name">
                                            @(coach.User?.FullName ?? "N/A")
                                        </div>

                                        <div class="trainer-username">
                                            @@@(coach.User?.UserName ?? "N/A")
                                        </div>
                                    </td>

                                    <td>
                                        @(coach.User?.Email ?? "N/A")
                                    </td>

                                    <td>
                                        @(coach.User?.PhoneNumber ?? "N/A")
                                    </td>

                                    <td>
                                        <span class="specialty">
                                            @coach.CoachSpecialty
                                        </span>
                                    </td>

                                    <td>
                                        <div class="action-group">

                                            <a asp-controller="Coach"
                                               asp-action="Details"
                                               asp-route-id="@coach.Id"
                                               class="action-btn">
                                                Details
                                            </a>

                                            <a asp-controller="Coach"
                                               asp-action="Edit"
                                               asp-route-id="@coach.Id"
                                               class="action-btn action-edit">
                                                Edit
                                            </a>

                                            <a asp-controller="Coach"
                                               asp-action="Delete"
                                               asp-route-id="@coach.Id"
                                               class="action-btn action-delete">
                                                Delete
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="fas fa-user-tie"></i>
                    </div>

                    <h3>No Trainers Found</h3>

                    <p>
                        There are currently no trainers in the system.
                    </p>

                </div>
            }

        </div>

    </div>
</div>