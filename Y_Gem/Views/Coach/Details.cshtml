@model Y_GYM.Models.Coach

@{
    ViewData["Title"] = "Coach Details";
}

<div class="container py-4">

    <div class="gym-page-header mb-4">
        <h1 class="mb-1">Coach Details</h1>
        <p class="text-muted mb-0">
            View complete coach information.
        </p>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card gym-card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Full Name
                            </label>

                            <div class="form-control bg-light">
                                @(Model.User?.FullName ?? "-")
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Username
                            </label>

                            <div class="form-control bg-light">
                                @(Model.User?.UserName ?? "-")
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Email
                            </label>

                            <div class="form-control bg-light">
                                @(Model.User?.Email ?? "-")
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Phone Number
                            </label>

                            <div class="form-control bg-light">
                                @(Model.User?.PhoneNumber ?? "-")
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Coach Specialty
                            </label>

                            <div class="form-control bg-light">
                                @(Model.CoachSpecialty ?? "-")
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Coach ID
                            </label>

                            <div class="form-control bg-light">
                                @Model.Id
                            </div>

                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="d-flex flex-wrap gap-2">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn gym-btn">
                            Edit Coach
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-danger">
                            Delete Coach
                        </a>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Back to Coaches
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>