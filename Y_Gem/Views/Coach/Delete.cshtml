@model Y_GYM.Models.Coach

@{
    ViewData["Title"] = "Delete Coach";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="gym-page-header mb-4">
                <h1 class="mb-1">Delete Coach</h1>
                <p class="text-muted mb-0">
                    Review the coach information before deleting.
                </p>
            </div>

            <div class="card gym-card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="alert alert-warning mb-4">
                        <strong>Warning:</strong>
                        Are you sure you want to delete this coach?
                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Full Name
                        </label>

                        <div class="form-control bg-light">
                            @(Model.User?.FullName ?? "-")
                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Username
                        </label>

                        <div class="form-control bg-light">
                            @(Model.User?.UserName ?? "-")
                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Email
                        </label>

                        <div class="form-control bg-light">
                            @(Model.User?.Email ?? "-")
                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Phone Number
                        </label>

                        <div class="form-control bg-light">
                            @(Model.User?.PhoneNumber ?? "-")
                        </div>

                    </div>

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            Coach Specialty
                        </label>

                        <div class="form-control bg-light">
                            @(Model.CoachSpecialty ?? "-")
                        </div>

                    </div>

                    <form asp-action="Delete" method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        @Html.AntiForgeryToken()

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete Coach
                            </button>

                            <a asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Back to Coaches
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>