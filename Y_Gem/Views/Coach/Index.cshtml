@model IEnumerable<Y_GYM.Models.Coach>

@{
    ViewData["Title"] = "Coaches";
}

<div class="container-fluid py-4">

    <div class="gym-page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Coaches</h1>
            <p class="text-muted mb-0">
                Manage gym coaches and their account information.
            </p>
        </div>

        <a asp-action="Create" class="btn gym-btn">
            <i class="bi bi-plus-lg me-1"></i>
            Add Coach
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card gym-card border-0 shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table gym-table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Coach</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Specialty</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var coach in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="fw-semibold">
                                            @(coach.User?.FullName ?? "No name")
                                        </div>
                                    </td>

                                    <td>
                                        @(coach.User?.UserName ?? "-")
                                    </td>

                                    <td>
                                        @(coach.User?.Email ?? "-")
                                    </td>

                                    <td>
                                        @(coach.User?.PhoneNumber ?? "-")
                                    </td>

                                    <td>
                                        <span class="badge text-bg-light">
                                            @(coach.CoachSpecialty ?? "-")
                                        </span>
                                    </td>

                                    <td class="text-end">

                                        <div class="btn-group" role="group">

                                            <a asp-action="Details"
                                               asp-route-id="@coach.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                Details
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@coach.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@coach.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="card gym-card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <div class="mb-3">
                    <i class="bi bi-person-badge fs-1"></i>
                </div>

                <h4>No coaches found</h4>

                <p class="text-muted mb-4">
                    There are currently no coaches registered in the gym.
                </p>

                <a asp-action="Create" class="btn gym-btn">
                    Add First Coach
                </a>

            </div>
        </div>
    }

</div>