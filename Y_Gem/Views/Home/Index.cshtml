@model IEnumerable<Y_GYM.Models.MembershipPlan>

@{
    ViewData["Title"] = "Home";
}

<!-- =========================================================
     HERO SECTION
     ========================================================= -->

<section class="hero-section">

    <div class="hs-slider owl-carousel">

        <!-- HERO 1 -->
        <div class="hs-item set-bg"
             data-setbg="/img/hero/hero-1.jpg">

            <div class="container">

                <div class="row align-items-center">

                    <div class="col-lg-7 col-md-9">

                        <div class="hi-text">

                            <span>
                                SHAPE YOUR BODY
                            </span>

                            <h1>
                                Be <strong>Strong</strong> and Healthy
                            </h1>

                            <p class="text-white mb-4">
                                Train with purpose, follow your progress,
                                and become a stronger version of yourself
                                with FITNESS GYM.
                            </p>

                            <div class="d-flex flex-wrap gap-2">

                                <a asp-controller="Account"
                                   asp-action="Register"
                                   class="primary-btn">

                                    <i class="fa fa-user-plus me-2"></i>

                                    Join FITNESS GYM

                                </a>

                                <a asp-controller="Account"
                                   asp-action="Login"
                                   class="btn btn-outline-light px-4">

                                    <i class="fa fa-sign-in me-2"></i>

                                    Login

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- HERO 2 -->
        <div class="hs-item set-bg"
             data-setbg="/img/hero/hero-2.jpg">

            <div class="container">

                <div class="row align-items-center">

                    <div class="col-lg-7 col-md-9">

                        <div class="hi-text">

                            <span>
                                WELCOME TO FITNESS GYM
                            </span>

                            <h1>
                                TRAIN <strong>HARDER</strong>
                            </h1>

                            <p class="text-white mb-4">
                                Memberships, classes, trainers,
                                bookings and fitness tracking
                                in one complete system.
                            </p>

                            <div class="d-flex flex-wrap gap-2">

                                <a asp-controller="MembershipPlans"
                                   asp-action="Index"
                                   class="primary-btn">

                                    <i class="fa fa-id-card-o me-2"></i>

                                    Explore Memberships

                                </a>

                                <a asp-controller="Class"
                                   asp-action="Index"
                                   class="btn btn-outline-light px-4">

                                    <i class="fa fa-calendar me-2"></i>

                                    Explore Classes

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


