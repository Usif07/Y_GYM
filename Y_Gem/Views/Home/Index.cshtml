                <div class="section-title">

                    <span>
                        OUR CLASSES
                    </span>

                    <h2>
                        WHAT WE CAN OFFER
                    </h2>

                </div>

            </div>


            <div class="col-lg-4 col-md-4 text-md-end mb-4">

                <a asp-controller="Class"
                   asp-action="Index"
                   class="primary-btn">

                    View All Classes

                    <i class="fa fa-arrow-right ms-2"></i>

                </a>

            </div>

        </div>


        <div class="row g-4">

            <div class="col-lg-4 col-md-6">

                <a asp-controller="Class"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="class-item h-100">

                        <div class="ci-pic">

                            <img src="/img/classes/class-1.jpg"
                                 alt="Strength Training"
                                 class="img-fluid">

                        </div>

                        <div class="ci-text">

                            <span>
                                Strength
                            </span>

                            <h5>
                                Weight Training
                            </h5>

                        </div>

                    </div>

                </a>

            </div>


            <div class="col-lg-4 col-md-6">

                <a asp-controller="Class"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="class-item h-100">

                        <div class="ci-pic">

                            <img src="/img/classes/class-2.jpg"
                                 alt="Cardio Training"
                                 class="img-fluid">

                        </div>

                        <div class="ci-text">

                            <span>
                                Cardio
                            </span>

                            <h5>
                                Indoor Cycling
                            </h5>

                        </div>

                    </div>

                </a>

            </div>


            <div class="col-lg-4 col-md-6">

                <a asp-controller="Class"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="class-item h-100">

                        <div class="ci-pic">

                            <img src="/img/classes/class-3.jpg"
                                 alt="Fitness Training"
                                 class="img-fluid">

                        </div>

                        <div class="ci-text">

                            <span>
                                Training
                            </span>

                            <h5>
                                Fitness Training
                            </h5>

                        </div>

                    </div>

                </a>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     MEMBERSHIP PLANS
     ========================================================= -->

<section class="pricing-section spad"
         id="pricing">

    <div class="container">

        <div class="row justify-content-center mb-5">

            <div class="col-xl-8 col-lg-9 text-center">

                <div class="section-title">

                    <span>
                        MEMBERSHIP PLANS
                    </span>

                    <h2>
                        CHOOSE YOUR MEMBERSHIP
                    </h2>

                </div>

                <p class="text-white mb-4">
                    You can create an account without choosing a membership.
                    Choose a plan whenever you are ready.
                </p>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn-outline-light px-4">

                    <i class="fa fa-user-plus me-2"></i>

                    Create Account Without Choosing a Plan

                </a>

            </div>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="row g-4 justify-content-center">

                @foreach (var plan in Model.Take(3))
                {
                    <div class="col-xl-4 col-lg-4 col-md-6">

                        <div class="gym-plan-card h-100">

                            <div class="gym-plan-icon">

                                <i class="fa fa-dumbbell"></i>

                            </div>


                            <div class="gym-plan-content">

                                <span class="gym-plan-label">
                                    FITNESS GYM MEMBERSHIP
                                </span>


                                <h3>
                                    @plan.Name
                                </h3>


                                <div class="gym-plan-price">

                                    @plan.Price.ToString("0.00")

                                    <span>
                                        EGP
                                    </span>

                                </div>


                                <div class="gym-plan-duration">

                                    <i class="fa fa-calendar me-2"></i>

                                    @plan.DurationDays days

                                </div>


                                <div class="gym-plan-divider">
                                </div>


                                <p>
                                    Choose this membership if it fits
                                    your training needs.
                                </p>


                                <!--
                                    The plan is OPTIONAL.
                                    It is only passed to Register
                                    when the visitor chooses it.
                                -->

                                <a asp-controller="Account"
                                   asp-action="Register"
                                   asp-route-planId="@plan.Id"
                                   class="primary-btn gym-plan-btn">

                                    <i class="fa fa-check-circle me-2"></i>

                                    Register With This Plan

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>


            <div class="row">

                <div class="col-12 text-center mt-5">

                    <a asp-controller="MembershipPlans"
                       asp-action="Index"
                       class="btn btn-outline-light px-4 py-2">

                        <i class="fa fa-list me-2"></i>

                        View All Membership Plans

                    </a>

                </div>

            </div>
        }
        else
        {
            <div class="row justify-content-center">

                <div class="col-lg-7">

                    <div class="text-center text-white">

                        <div class="gym-plan-icon mx-auto mb-3">

                            <i class="fa fa-info-circle"></i>

                        </div>

                        <h4 class="text-white mb-3">
                            Membership Plans Coming Soon
                        </h4>

                        <p class="text-white-50 mb-4">
                            Our membership plans are currently
                            being prepared. You can still create
                            your FITNESS GYM account.
                        </p>

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="primary-btn">

                            <i class="fa fa-user-plus me-2"></i>

                            Create Account

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</section>


<!-- =========================================================
     SERVICES
     ========================================================= -->

<section class="choseus-section spad"
